---
import "../styles/glass.css";
import "../styles/loading.css";
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader";
import SiteFooter from "../components/SiteFooter.astro";
import HomeButton from "../components/HomeButton.astro";
import ContactModal from "../components/ContactModal";
import { getSiteSettings } from "../lib/settings";
import { enPath, getDict, langUrl, pickDict, CONTACT_MODAL_DICT_KEYS, SITE_HEADER_DICT_KEYS, type Lang } from "../lib/i18n";
import { SITE_URL } from "../lib/detail";

interface Props {
	title?: string;
	description?: string;
	/** Which profile this page belongs to — drives the header switcher + footer line. */
	profile?: "se" | "knowme";
	/** Page language. English at /<page>, Bangla at /bn/<page>. */
	lang?: Lang;
	/** Open Graph image (absolute URL). Defaults to the speaker photo.
	    Pass null to omit og:image entirely (detail pages whose subject
	    has no cover art must never fall back to the portrait). */
	ogImage?: string | null;
	/** Open Graph type. Defaults to "website" (detail pages use "article"). */
	ogType?: string;
	/** Canonical URL. Detail pages pass the live-base URL explicitly. */
	canonical?: string;
}

const {
	title = "Mahmudul Hasan Riaz",
	description = "Software Engineer, Entrepreneur and Nasheed Artist — Dhaka, Bangladesh.",
	profile = "se",
	lang = "en",
	ogImage,
	ogType = "website",
	canonical,
} = Astro.props;

const t = getDict(lang);

// OG image: explicit prop wins, then the admin-managed portrait, then
// the repo speaker photo. A relative admin URL is resolved against the
// page origin (OG images must be absolute).
const settings = await getSiteSettings();
const settingsPortrait = settings.portraitUrl
	? settings.portraitUrl.startsWith("/")
		? `${Astro.url.origin}${settings.portraitUrl}`
		: settings.portraitUrl
	: undefined;
const ogImageUrl =
	ogImage === null
		? null
		: (ogImage ?? settingsPortrait ?? `${Astro.url.origin}/speaker.jpg`);

// --- Multilingual SEO (one URL per language, hreflang cluster) --------
// Canonical = this page's OWN absolute URL, never the other language's
// (Google: a canonical must point at a page in the SAME language).
// hreflang: the identical set on BOTH versions — self + the other
// language + x-default — all ABSOLUTE, built from Astro.site (the
// workers.dev URL for now; the custom domain later), never hardcoded.
// x-default = the ADMIN-CONFIGURED default language version: default
// "bn" → the Bangla URL; "en" or "system" → the English URL. The
// admin setting (settings.defaultLanguage) is read at build/request
// time and never hardcoded here.
// No noindex on either language (the dev-only robots meta below is
// the launch gate for the whole site, both languages alike).
const siteBase = (Astro.site?.toString() ?? SITE_URL).replace(/\/$/, "");
const pathEn = enPath(Astro.url.pathname);
const urlEn = `${siteBase}${pathEn === "/" ? "/" : pathEn}`;
const urlBn = `${siteBase}${pathEn === "/" ? "/bn/" : `/bn${pathEn}`}`;
const xDefaultUrl =
	settings.defaultLanguage === "bn" ? urlBn : urlEn;
const canonicalUrl = canonical ?? Astro.url.href;
const ogLocale = lang === "bn" ? "bn_BD" : "en_US";
const ogLocaleAlt = lang === "bn" ? "en_US" : "bn_BD";

// Floating home button (2026-11-09, home shortcut): rendered on
// every page EXCEPT the homepage itself ("/" and "/bn[/]") — there
// it would point at the page you're already on. A direct <body>
// child (never inside .page) so no ancestor can disturb its fixed
// positioning.
const isHome =
	Astro.url.pathname === "/" ||
	Astro.url.pathname === "/bn" ||
	Astro.url.pathname === "/bn/";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={urlEn} />
		<link rel="alternate" hreflang="bn" href={urlBn} />
		<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
		<!-- DEV ONLY: keep the in-progress site out of search indexes until launch. Remove at launch. -->
		<meta name="robots" content="noindex, nofollow" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:site_name" content="Mahmudul Hasan Riaz" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlt} />
		{ogImageUrl ? <meta property="og:image" content={ogImageUrl} /> : null}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImageUrl ? <meta name="twitter:image" content={ogImageUrl} /> : null}
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		 />
		<title>{title}</title>
		{/* ISSUE 7A: View Transitions — same-origin navigations swap pages
		    without a full reload (no more blank full-page load on every
		    click). Also switches on Astro prefetch: hover-prefetch for all
		    links by default; card links below carry data-astro-prefetch
		    explicitly too. */}
		<ClientRouter />
		<script is:inline define:vars={{ defaultLanguage: settings.defaultLanguage }}>
			// First-visit language resolution (client-side ONLY — no
			// server/edge redirect, so crawlers always reach BOTH
			// language URLs directly). Fires ONLY when the visitor has
			// NO stored language preference: a stored choice always
			// wins, and a /bn/* URL is an explicit choice that is never
			// redirected away from. "system" reads navigator.language
			// (bn / bn-BD → Bangla, anything else → English). Runs in
			// <head> before paint so there is no flash of the wrong
			// language; without JS nothing happens (noscript-safe).
			(function () {
				try {
					var stored = null;
					try {
						stored = localStorage.getItem("site-lang");
					} catch (e) {}
					if (stored === "en" || stored === "bn") return;
					var target = null;
					if (defaultLanguage === "bn") {
						target = "bn";
					} else if (defaultLanguage === "system") {
						var l = (navigator.language || "").toLowerCase();
						if (l.indexOf("bn") === 0) target = "bn";
					}
					if (target !== "bn") return;
					var p = location.pathname;
					if (p === "/bn" || p.indexOf("/bn/") === 0) return;
					location.replace(
						"/bn" + p + location.search + location.hash,
					);
				} catch (e) {}
			})();
		</script>
		<script is:inline>
			// Theme: system preference by default; manual toggle overrides + remembered.
			try {
				const saved = localStorage.getItem("theme");
				if (saved === "light" || saved === "dark") {
					document.documentElement.setAttribute("data-theme", saved);
				} else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					document.documentElement.setAttribute("data-theme", "dark");
				} else {
					document.documentElement.setAttribute("data-theme", "light");
				}
			} catch {
				/* storage unavailable — CSS media query handles it */
			}
		</script>
		<style is:global>
			/* Pull-to-refresh fix (2026-11-09): the old
			   overscroll-behavior-y: none on html/body lived here and
			   in glass.css — it disabled pull-to-refresh (an overscroll
			   gesture), so it is REMOVED from both places and must not
			   come back. The slow footer spring-back it once guarded
			   was the scroll-lock gap + header stuck loop, both fixed
			   separately (reference-counted scrollLock.ts; constant
			   header height, transform-only stuck move). The remaining
			   native rubber-band is standard mobile behaviour. */
		</style>
	</head>
	<body>
		{/* Bottom padding removed so the footer attaches flush to the page edge. */}
		<div class="page" style="padding-bottom:0;">
			<SiteHeader
				current={profile}
				lang={lang}
				currentPath={Astro.url.pathname}
				dict={pickDict(t, SITE_HEADER_DICT_KEYS)}
				client:load
			/>
			<main>
				<slot />
			</main>
			<SiteFooter profile={profile} lang={lang} dict={t} />
		</div>
		<ContactModal lang={lang} dict={pickDict(t, CONTACT_MODAL_DICT_KEYS)} client:load />
		{/* Floating home button — off-home pages only (see isHome
		    above); the button itself is a plain link home, its
		    inline script only controls when it is visible. */}
		{!isHome ? (
			<HomeButton href={langUrl("/", lang)} label={t.navHome} />
		) : null}
		<div id="page-progress" aria-hidden="true"></div>
		<noscript>
			<style>
				.grid-thumb img,
				.deck-thumb img,
				.release-card-thumb img,
				.mini-thumb img {
					opacity: 1 !important;
				}
			</style>
		</noscript>
		{/* Shared detail-page wiring (sliders, video facades, contact
		    buttons) — one deferred script, loaded here so no inline
		    script ever sits inside <main>. */}
		<script src="/js/detail.js" defer></script>
		<script is:inline>
			// Loading feedback (worker G): Astro is an MPA, so a link click
			// means a full page load with no built-in indicator. Show the
			// top progress bar INSTANTLY on any internal navigation click,
			// press the clicked card/link, and fade images in over a frosted
			// skeleton (loading.css) once they actually load.
			(function () {
				var bar = document.getElementById("page-progress");
				if (!bar) return;
				var timer = null;
				var width = 0;
				function startNav(el) {
					if (bar.classList.contains("is-active")) return;
					if (el) el.classList.add("is-navigating");
					bar.classList.remove("is-done");
					bar.classList.add("is-active");
					bar.style.width = "18%";
					width = 18;
					if (timer) window.clearInterval(timer);
					// Creep toward 90% while the next page loads; the real
					// navigation (or pageshow) ends it. Never completes on
					// its own, so a slow load never looks finished early.
					timer = window.setInterval(function () {
						width = Math.min(90, width + (90 - width) * 0.12);
						bar.style.width = width.toFixed(1) + "%";
					}, 200);
				}
				function finishNav() {
					if (timer) {
						window.clearInterval(timer);
						timer = null;
					}
					bar.style.width = "100%";
					bar.classList.add("is-done");
					bar.classList.remove("is-active");
					window.setTimeout(function () {
						bar.style.width = "0";
					}, 250);
				}
				document.addEventListener("click", function (e) {
					var t = e.target;
					if (!(t instanceof Element)) return;
					var link = t.closest("a[href]");
					if (!link) return;
					var href = link.getAttribute("href") || "";
					// Same-page anchors, external links, downloads and new
					// tabs navigate without a full load — no bar needed.
					if (
						href.startsWith("#") ||
						href.startsWith("mailto:") ||
						href.startsWith("tel:") ||
						link.hasAttribute("download") ||
						link.getAttribute("target") === "_blank" ||
						(link.getAttribute("href") || "").startsWith("http")
					)
						return;
					if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
					startNav(link);
				});
				window.addEventListener("pageshow", finishNav);
				window.addEventListener("pagehide", finishNav);

				// Image reveal: mark each card image loaded so it fades in
				// over its skeleton; cached images are already complete.
				function watchImg(img) {
					if (img.complete && img.naturalWidth > 0) {
						img.classList.add("img-loaded");
						return;
					}
					img.addEventListener("load", function () {
						img.classList.add("img-loaded");
					});
					img.addEventListener("error", function () {
						img.classList.add("img-loaded");
					});
				}
				document
					.querySelectorAll(
						".grid-thumb img, .deck-thumb img, .release-card-thumb img, .mini-thumb img",
					)
					.forEach(watchImg);
				// React islands mount after this script runs — catch them.
				new MutationObserver(function (mutations) {
					mutations.forEach(function (m) {
						m.addedNodes.forEach(function (node) {
							if (!(node instanceof Element)) return;
							if (node.matches(".grid-thumb img, .deck-thumb img, .release-card-thumb img, .mini-thumb img"))
								watchImg(node);
							node
								.querySelectorAll(".grid-thumb img, .deck-thumb img, .release-card-thumb img, .mini-thumb img")
								.forEach(watchImg);
						});
					});
				}).observe(document.body, { childList: true, subtree: true });
			})();
		</script>
	</body>
</html>
