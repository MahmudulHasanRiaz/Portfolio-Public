---
import "../styles/glass.css";
import SiteHeader from "../components/SiteHeader";
import SiteFooter from "../components/SiteFooter.astro";
import ContactModal from "../components/ContactModal";

interface Props {
	title?: string;
	description?: string;
	/** Which profile this page belongs to — drives the header switcher + footer line. */
	profile?: "se" | "knowme";
	/** Open Graph image (absolute URL). Defaults to the speaker photo. */
	ogImage?: string;
	/** Open Graph type. Defaults to "website" (detail pages use "article"). */
	ogType?: string;
}

const {
	title = "Mahmudul Hasan Riaz",
	description = "Software Engineer, Entrepreneur and Nasheed Artist — Dhaka, Bangladesh.",
	profile = "se",
	ogImage = "https://riaz.com.bd/speaker.jpg",
	ogType = "website",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:site_name" content="Mahmudul Hasan Riaz" />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			// Theme: system preference by default; manual toggle overrides + remembered.
			try {
				const saved = localStorage.getItem("theme");
				if (saved === "light" || saved === "dark") {
					document.documentElement.setAttribute("data-theme", saved);
				} else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					document.documentElement.setAttribute("data-theme", "dark");
				} else {
					document.documentElement.setAttribute("data-theme", "light");
				}
			} catch {
				/* storage unavailable — CSS media query handles it */
			}
		</script>
	</head>
	<body>
		{/* Bottom padding removed so the footer attaches flush to the page edge. */}
		<div class="page" style="padding-bottom:0;">
			<SiteHeader current={profile} client:load />
			<main>
				<slot />
			</main>
			<SiteFooter profile={profile} />
		</div>
		<ContactModal client:load />
	</body>
</html>
