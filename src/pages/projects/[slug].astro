---
import Layout from "../../layouts/Layout.astro";
import {
	getCollection,
	getEntry,
	getLiveEntry,
	render,
} from "astro:content";
import { createPublicContentLoader } from "../../loaders/public-content";
import DetailCta from "../../components/DetailCta.astro";
import DetailMedia from "../../components/DetailMedia.astro";
import DetailVideoFacade from "../../components/DetailVideoFacade.astro";
import KeyStrip from "../../components/KeyStrip.astro";
import MarkdownBody from "../../components/MarkdownBody.astro";
import PrevNext from "../../components/PrevNext.astro";
import TechChips from "../../components/TechChips.astro";
import { formatDate, getProjects } from "../../lib/content";
import { getDict, langUrl } from "../../lib/i18n";
import {
	SITE_URL,
	absUrl,
	isRealUrl,
	mergeDetail,
	parseBodyBlocks,
	serviceForTags,
} from "../../lib/detail";

// Static detail route — hybrid live-then-static, ISSUE 7A (plan §2):
// known slugs are prerendered at build time, so a click serves static
// HTML from the edge instead of waiting on the Worker → slow VPS API
// (~2.2s TTFB). The body still prefers the live entry when the API is
// reachable at build time, then the build-time row, then a 404.
// Route caching is in astro.config.mjs.
// NOTE: `export const prerender = false` was REMOVED on purpose —
// Astro only calls getStaticPaths() for prerendered routes, so keeping
// it made getStaticPaths dead code (no static files were ever built).
// Trade-off: a slug published after the build 404s until the next
// rebuild — the on-demand fallback for new slugs needs a twin SSR
// route with the same pattern (Astro serves the static file when one
// exists and falls through to the SSR route otherwise).
export async function getStaticPaths() {
	// Slugs from the build-time collection AND the live API. When the
	// live API is unreachable at build time, fall back to build-time
	// slugs only — the build never fails on the live API.
	const slugs = new Set<string>();
	for (const entry of await getCollection("projects")) {
		slugs.add(entry.data.slug);
	}
	try {
		const { entries } = await createPublicContentLoader(
			"projects",
		).loadCollection();
		for (const entry of entries) {
			const slug =
				typeof entry.data.slug === "string" ? entry.data.slug : entry.id;
			if (slug) slugs.add(slug);
		}
	} catch {
		// Live API unreachable at build time — build-time slugs only.
	}
	return [...slugs].map((slug) => ({ params: { slug } }));
}

const lang = "en" as const;
const t = getDict(lang);

const { slug } = Astro.params;
const liveResult = slug
	? await getLiveEntry("liveProjects", slug).catch(() => undefined)
	: undefined;
const liveEntry = liveResult?.entry;
if (liveEntry) Astro.cache.set(liveEntry);
// The build-time row is fetched even when a live row exists: its body
// is the full story when the live row carries only the short
// description, and its fields fill any gaps the live row leaves empty.
const buildEntry = slug ? await getEntry("projects", slug) : undefined;
const entry = liveEntry ?? buildEntry;
if (!entry) Astro.response.status = 404;

// Build-time entries render their markdown body; live entries carry the
// body as a plain `content` string, rendered as blocks below.
const rendered = buildEntry ? await render(buildEntry) : undefined;
const Content = rendered?.Content;

interface ProjectData {
	title: string;
	description?: string;
	content?: string;
	longDescription?: string;
	tags?: string[];
	techs?: string[];
	publishedAt?: string;
	thumbnail?: string;
	thumbnailType?: "image" | "video";
	thumbnailVideoUrl?: string;
	gallery?: string[];
	videos?: { url: string; title?: string }[];
	client?: string;
	role?: string;
	year?: string;
	status?: string;
	liveUrl?: string;
}

const liveData = liveEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const buildData = buildEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const d = mergeDetail(buildData, liveData) as unknown as
	| ProjectData
	| undefined;

// Full story, in priority order: the backend's longDescription when it
// exists, then the build-time markdown body, then the live content
// string, then the short description (never an invented story).
const storyBlocks = d?.longDescription
	? parseBodyBlocks(d.longDescription)
	: !Content && d?.content
		? parseBodyBlocks(d.content)
		: [];
const showDescriptionFallback =
	!Content && storyBlocks.length === 0 && Boolean(d?.description);

// Back link returns to origin: a visitor who arrived from a case
// study ("View the project") goes back to that case study.
const fromParam = Astro.url.searchParams.get("from") ?? "";
const fromCaseStudy = fromParam.startsWith("case-study:")
	? fromParam.slice("case-study:".length)
	: null;
const backHref = fromCaseStudy
	? langUrl(`/case-studies/${fromCaseStudy}`, lang)
	: langUrl("/projects", lang);
const backLabel = fromCaseStudy ? t.backCaseStudy : t.backAllProjects;

// Video thumbnail: thumbnailVideoUrl is the video file, thumbnail the
// poster image; when the thumbnail itself is the video there is no poster.
const isVideoThumb = d?.thumbnailType === "video";
const videoSrc = isVideoThumb
	? (d?.thumbnailVideoUrl ?? d?.thumbnail)
	: undefined;
const videoPoster =
	isVideoThumb &&
	d?.thumbnailVideoUrl &&
	d?.thumbnail &&
	d.thumbnail !== d.thumbnailVideoUrl &&
	!/\.(mp4|webm|mov|m4v)([?#]|$)/i.test(d.thumbnail)
		? d.thumbnail
		: null;
const coverImage = !isVideoThumb && d?.thumbnail ? d.thumbnail : videoPoster;

// Prev/next by date order (newest first): prev = older, next = newer.
const allProjects = await getProjects();
const currentIndex = allProjects.findIndex((p) => p.data.slug === slug);
const prevProject =
	currentIndex >= 0 ? allProjects[currentIndex + 1] : undefined;
const nextProject =
	currentIndex > 0 ? allProjects[currentIndex - 1] : undefined;
const thumbOf = (p: (typeof allProjects)[number] | undefined) =>
	p?.data.thumbnailType !== "video" && p?.data.thumbnail
		? p.data.thumbnail
		: null;

const pageUrl = `${SITE_URL}/projects/${slug}`;
const jsonLd = d
	? {
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "SoftwareApplication",
					name: d.title,
					description: d.description,
					inLanguage: "en",
					applicationCategory: "BusinessApplication",
					url: pageUrl,
					...(coverImage ? { image: absUrl(coverImage) } : {}),
					author: {
						"@type": "Person",
						name: "Mahmudul Hasan Riaz",
						url: SITE_URL,
					},
					...(d.publishedAt ? { datePublished: d.publishedAt } : {}),
				},
				{
					"@type": "BreadcrumbList",
					itemListElement: [
						{
							"@type": "ListItem",
							position: 1,
							name: "Home",
							item: SITE_URL,
						},
						{
							"@type": "ListItem",
							position: 2,
							name: t.allProjects,
							item: `${SITE_URL}/projects`,
						},
						{
							"@type": "ListItem",
							position: 3,
							name: d.title,
							item: pageUrl,
						},
					],
				},
			],
		}
	: null;
---

<Layout
	title={
		d ? `${d.title} — Mahmudul Hasan Riaz` : `${t.notFoundProject} — Mahmudul Hasan Riaz`
	}
	description={d?.description}
	ogType="website"
	ogImage={coverImage ? absUrl(coverImage) : null}
	canonical={pageUrl}
	lang={lang}
>
	{
		entry && d ? (
			<section class="glass">
				{jsonLd && (
					<script
						type="application/ld+json"
						set:html={JSON.stringify(jsonLd)}
					/>
				)}

				<a class="back-link" href={backHref}>
					{backLabel}
				</a>
				{d.thumbnail &&
					(isVideoThumb && videoSrc ? (
						<div class="detail-hero">
							<DetailVideoFacade
								src={videoSrc}
								poster={videoPoster}
								title={d.title}
								lang={lang}
								dict={t}
							/>
						</div>
					) : (
						<div class="detail-hero">
							<img src={d.thumbnail} alt={d.title} />
						</div>
					))}
				<h1 class="detail-title">{d.title}</h1>
				{d.tags?.length ? (
					<div class="tag-row" style="margin-top:12px;">
						{d.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				) : null}
				<KeyStrip
					items={[
						d.client ? { label: t.clientLabel, value: d.client } : null,
						d.role ? { label: t.roleLabel, value: d.role } : null,
						{
							label: t.publishedLabel,
							value: formatDate(d.publishedAt, lang) || d.year,
						},
						d.tags?.length
							? { label: t.categoryLabel, value: d.tags.join(", ") }
							: null,
						d.status ? { label: t.statusLabel, value: d.status } : null,
						d.liveUrl && isRealUrl(d.liveUrl)
							? { label: t.liveSiteLabel, value: t.visitSite, href: d.liveUrl }
							: null,
					]}
				/>
				<section class="detail-section" aria-label={t.aboutProject}>
					<h2 class="detail-h2">{t.aboutProject}</h2>
					{Content ? (
						<div class="detail-body">
							<Content />
						</div>
					) : storyBlocks.length > 0 ? (
						<MarkdownBody blocks={storyBlocks} />
					) : showDescriptionFallback ? (
						<div class="detail-body">
							<p>{d.description}</p>
						</div>
					) : null}
				</section>
				<TechChips techs={d.techs ?? []} lang={lang} dict={t} />
				<DetailMedia
					gallery={d.gallery ?? []}
					videos={d.videos ?? []}
					exclude={d.thumbnail}
					altBase={`${d.title} gallery image`}
				/>
				<DetailCta
					title={`${t.wantSystemLike} ${d.title}?`}
					text={t.projectCtaText}
					service={serviceForTags(d.tags)}
					source="project-detail"
					lang={lang}
					dict={t}
				/>
				<PrevNext
					prev={
						prevProject
							? {
									href: langUrl(`/projects/${prevProject.data.slug}`, lang),
									title: prevProject.data.title,
									thumb: thumbOf(prevProject),
								}
							: null
					}
					next={
						nextProject
							? {
									href: langUrl(`/projects/${nextProject.data.slug}`, lang),
									title: nextProject.data.title,
									thumb: thumbOf(nextProject),
								}
							: null
					}
					lang={lang}
					dict={t}
				/>
			</section>
		) : (
			<section class="glass">
				<a class="back-link" href={langUrl("/projects", lang)}>
					{t.backAllProjects}
				</a>
				<h1 class="detail-title">{t.notFoundProject}</h1>
				<p class="empty-state">{t.notPublishedProject}</p>
			</section>
		)
	}
</Layout>
