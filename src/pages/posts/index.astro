---
import Layout from "../../layouts/Layout.astro";
import { getPosts, formatDate, truncateShort } from "../../lib/content";

const posts = await getPosts();
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
---

<Layout
	title="All posts — Mahmudul Hasan Riaz"
	description="Posts by Mahmudul Hasan Riaz — ERP, e-commerce, WordPress, and nasheed."
>
	<p>
		<a href="/" class="back-link">← Back to home</a>
	</p>
	<h1 style="margin:0 0 8px;font-size:26px;line-height:1.25;">All posts</h1>

	{
		posts.length === 0 ? (
			<section class="glass section">
				<p class="empty-state">No posts published yet.</p>
			</section>
		) : (
			<>
				{allTags.length > 0 ? (
					<div class="chip-row" id="post-filters" style="margin-top:16px;">
						<button type="button" class="chip active" data-tag="all">
							All
						</button>
						{allTags.map((t) => (
							<button type="button" class="chip" data-tag={t}>
								{t}
							</button>
						))}
					</div>
				) : null}
				<p class="count-line" id="post-count">
					Showing {posts.length} of {posts.length} posts
				</p>
				<section class="card-grid section" id="post-grid">
					{posts.map((post) => (
						<a
							class="grid-card"
							href={`/posts/${post.data.slug}`}
							data-tags={(post.data.tags ?? []).join(",")}
						>
							<div class="grid-thumb">
								{post.data.thumbnail ? (
									<img
										src={post.data.thumbnail}
										alt={post.data.title}
										loading="lazy"
									/>
								) : (
									<div class="thumb-fallback">
										{post.data.title.charAt(0)}
									</div>
								)}
							</div>
							<div class="grid-body">
								<h3>{post.data.title}</h3>
								{post.data.excerpt ? <p>{truncateShort(post.data.excerpt)}</p> : null}
								<p class="grid-meta">
									{formatDate(post.data.publishedAt)}
									{post.data.readingTime
										? ` · ${post.data.readingTime} min read`
										: ""}
								</p>
							</div>
						</a>
					))}
				</section>
			</>
		)
	}
</Layout>

<script is:inline>
	// Client-side tag filter (no framework).
	const chips = document.querySelectorAll("#post-filters .chip");
	const cards = document.querySelectorAll("#post-grid .grid-card");
	const count = document.getElementById("post-count");
	const total = cards.length;
	chips.forEach((chip) => {
		chip.addEventListener("click", () => {
			chips.forEach((c) => c.classList.remove("active"));
			chip.classList.add("active");
			const tag = chip.getAttribute("data-tag");
			let shown = 0;
			cards.forEach((card) => {
				const tags = (card.getAttribute("data-tags") || "")
					.split(",")
					.filter(Boolean);
				const show = tag === "all" || tags.includes(tag || "");
				card.style.display = show ? "" : "none";
				if (show) shown++;
			});
			if (count) count.textContent = `Showing ${shown} of ${total} posts`;
		});
	});
</script>
