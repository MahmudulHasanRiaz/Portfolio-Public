---
import Layout from "../../layouts/Layout.astro";
import {
	getPosts,
	formatDate,
	readingTimeFromText,
} from "../../lib/content";
import { applySiteCopy, getDict, langUrl, readingTimeLabel, showingLabel } from "../../lib/i18n";
import { getSiteSettings } from "../../lib/settings";

// Posts archive — fixed strings from the dictionary (same keys as the
// /bn/ archive). Reading time is computed from the actual post text.
const lang = "en" as const;
const t = applySiteCopy(getDict(lang), lang, await getSiteSettings());

const posts = await getPosts();
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();

// Unsplash card thumbs ship at w=1200 in content/API rows but render at
// ~360px wide (2x retina ≈ 720px) — request w=800/q=75 instead: measured
// 124KB → 67KB per image (~46% less). Non-Unsplash URLs pass through.
const sizedThumb = (url: string | null | undefined, w = 800) =>
	url?.includes("images.unsplash.com")
		? url.replace(/w=\d+/, `w=${w}`).replace(/q=\d+/, "q=75")
		: url;
---

<Layout
	title={t.postsPageTitle}
	description={t.postsPageDescription}
	lang={lang}
>
	<p>
		<a href={langUrl("/", lang)} class="back-link">{t.backHome}</a>
	</p>
	<h1 style="margin:0 0 8px;font-size:26px;line-height:1.25;">{t.allPosts}</h1>

	{
		posts.length === 0 ? (
			<section class="glass section">
				<p class="empty-state">{t.emptyPosts}</p>
			</section>
		) : (
			<>
				{allTags.length > 0 ? (
					<div class="chip-row" id="post-filters" style="margin-top:16px;">
						<button type="button" class="chip active" data-tag="all" aria-pressed="true">
							{t.allChip}
						</button>
						{allTags.map((tag) => (
							<button type="button" class="chip" data-tag={tag} aria-pressed="false">
								{tag}
							</button>
						))}
					</div>
				) : null}
				<p class="count-line" id="post-count" data-count-template={t.showingPosts}>
					{showingLabel(t.showingPosts, posts.length, posts.length)}
				</p>
				<section class="card-grid section" id="post-grid">
					{posts.map((post) => {
						// Reading time is COMPUTED from the actual post text —
						// same as the homepage cards — never the stored value
						// on its own (the API ships readingTime: 1 for every
						// post). Stored value is only a fallback.
						const postText =
							post.body ?? (post.data as { content?: string }).content ?? "";
						const readingTime =
							readingTimeFromText(postText) ?? post.data.readingTime ?? undefined;
						return (
							<a
								class="grid-card"
								href={langUrl(`/posts/${post.data.slug}`, lang)}
								data-astro-prefetch="hover"
								data-tags={(post.data.tags ?? []).join(",")}
							>
								<div class="grid-thumb">
									{post.data.thumbnailType === "video" &&
									post.data.thumbnail ? (
										<video
											src={post.data.thumbnail}
											aria-label={post.data.title}
											muted
											loop
											playsinline
											autoplay={post.data.thumbnailAutoplay !== false}
											preload="metadata"
										/>
									) : post.data.thumbnail ? (
										<img
											src={sizedThumb(post.data.thumbnail)}
											alt={post.data.title}
											width="800"
											height="500"
											loading="lazy"
											decoding="async"
										/>
									) : (
										<div class="thumb-fallback">
											{post.data.title.charAt(0)}
										</div>
									)}
								</div>
								<div class="grid-body">
									{post.data.tags?.[0] ? (
										<div class="tag-row">
											<span class="tag">{post.data.tags[0]}</span>
										</div>
									) : null}
									<h3>{post.data.title}</h3>
									<p class="grid-meta">
										{formatDate(post.data.publishedAt, lang)}
										{readingTime ? ` · ${readingTimeLabel(readingTime, lang)}` : ""}
									</p>
								</div>
							</a>
						);
					})}
				</section>
			</>
		)
	}
</Layout>

<script is:inline>
	// Client-side tag filter (no framework).
	const chips = document.querySelectorAll("#post-filters .chip");
	const cards = document.querySelectorAll("#post-grid .grid-card");
	const count = document.getElementById("post-count");
	const total = cards.length;
	const template = count ? count.getAttribute("data-count-template") || "" : "";
	const fmt = (n) =>
		template.includes("টি") ? n.toLocaleString("bn-BD") : String(n);
	chips.forEach((chip) => {
		chip.addEventListener("click", () => {
			chips.forEach((c) => {
				c.classList.remove("active");
				c.setAttribute("aria-pressed", "false");
			});
			chip.classList.add("active");
			chip.setAttribute("aria-pressed", "true");
			const tag = chip.getAttribute("data-tag");
			let shown = 0;
			cards.forEach((card) => {
				const tags = (card.getAttribute("data-tags") || "")
					.split(",")
					.filter(Boolean);
				const show = tag === "all" || tags.includes(tag || "");
				card.style.display = show ? "" : "none";
				if (show) shown++;
			});
			if (count)
				count.textContent = template
					? template.replace("{shown}", fmt(shown)).replace("{total}", fmt(total))
					: `Showing ${shown} of ${total} posts`;
		});
	});
</script>
