---
import Layout from "../../layouts/Layout.astro";
import {
	getCollection,
	getEntry,
	getLiveEntry,
	render,
} from "astro:content";
import { createPublicContentLoader } from "../../loaders/public-content";
import DetailMedia from "../../components/DetailMedia.astro";
import DetailVideoFacade from "../../components/DetailVideoFacade.astro";
import PrevNext from "../../components/PrevNext.astro";
import { getPosts, formatDate, readingTimeFromText } from "../../lib/content";
import {
	SITE_URL,
	absUrl,
	mergeDetail,
	parseBodyBlocks,
} from "../../lib/detail";
import { PROFILE } from "../../data/site";
import { getDict, langUrl, readingTimeLabel } from "../../lib/i18n";

// Static detail route — hybrid live-then-static, ISSUE 7A (plan §2):
// known slugs are prerendered at build time, so a click serves static
// HTML from the edge instead of waiting on the Worker → slow VPS API
// (~2.2s TTFB). The body still prefers the live entry when the API is
// reachable at build time, then the build-time row, then a 404.
// Route caching is in astro.config.mjs.
// NOTE: `export const prerender = false` was REMOVED on purpose —
// Astro only calls getStaticPaths() for prerendered routes, so keeping
// it made getStaticPaths dead code (no static files were ever built).
// Trade-off: a slug published after the build 404s until the next
// rebuild — the on-demand fallback for new slugs needs a twin SSR
// route with the same pattern (Astro serves the static file when one
// exists and falls through to the SSR route otherwise).
export async function getStaticPaths() {
	// Slugs from the build-time collection AND the live API. When the
	// live API is unreachable at build time, fall back to build-time
	// slugs only — the build never fails on the live API.
	const slugs = new Set<string>();
	for (const entry of await getCollection("posts")) {
		slugs.add(entry.data.slug);
	}
	try {
		const { entries } = await createPublicContentLoader(
			"posts",
		).loadCollection();
		for (const entry of entries) {
			const slug =
				typeof entry.data.slug === "string" ? entry.data.slug : entry.id;
			if (slug) slugs.add(slug);
		}
	} catch {
		// Live API unreachable at build time — build-time slugs only.
	}
	return [...slugs].map((slug) => ({ params: { slug } }));
}

const lang = "en" as const;
const t = getDict(lang);

const { slug } = Astro.params;
if (!slug) Astro.response.status = 404;

const liveResult = slug ? await getLiveEntry("livePosts", slug).catch(() => undefined) : undefined;
const liveEntry = liveResult?.entry;
if (liveEntry) Astro.cache.set(liveEntry);
const buildEntry = slug ? await getEntry("posts", slug) : undefined;

const entry = liveEntry ?? buildEntry;
if (!entry) Astro.response.status = 404;

interface PostData {
	title?: string;
	description?: string;
	excerpt?: string;
	content?: string;
	tags?: string[];
	publishedAt?: string;
	thumbnail?: string;
	thumbnailType?: "image" | "video";
	thumbnailVideoUrl?: string;
	readingTime?: number;
	gallery?: string[];
	videos?: Array<{ url: string; title?: string }>;
}

const liveData = liveEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const buildData = buildEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const data = mergeDetail(buildData, liveData) as unknown as
	| PostData
	| undefined;

// Build-time entries render their markdown natively; live entries carry
// the body as a plain `content` string — parsed into content blocks so
// '## ' lines become real <h2> headings instead of rendering literally
// as markdown text (the live bug: '## One queue for every store'
// visible on the page, zero <h2> elements).
const rendered = buildEntry ? await render(buildEntry) : undefined;
const Content = rendered?.Content;
const storyBlocks =
	!Content && data?.content ? parseBodyBlocks(data.content) : [];

const posts = await getPosts();
const idx = slug ? posts.findIndex((p) => p.data.slug === slug) : -1;
const prev = idx > 0 ? posts[idx - 1] : undefined;
const next = idx >= 0 && idx < posts.length - 1 ? posts[idx + 1] : undefined;
const related = posts.filter((p) => p.data.slug !== slug).slice(0, 3);
const thumbOf = (p: (typeof posts)[number] | undefined) =>
	p?.data.thumbnailType !== "video" && p?.data.thumbnail
		? p.data.thumbnail
		: null;

const title = data?.title ?? t.notFoundPost;
const description = data?.excerpt ?? data?.description;
const readingTime =
	data?.readingTime ??
	readingTimeFromText(data?.content ?? buildEntry?.body) ??
	undefined;
const thumb = data?.thumbnail;
const tags = data?.tags ?? [];

const isVideoThumb = data?.thumbnailType === "video";
const videoSrc = isVideoThumb
	? (data?.thumbnailVideoUrl ?? data?.thumbnail)
	: undefined;
const videoPoster =
	isVideoThumb && data?.thumbnailVideoUrl ? (data?.thumbnail ?? null) : null;
const coverImage = !isVideoThumb && thumb ? thumb : videoPoster;

const pageUrl = `${SITE_URL}/posts/${slug}`;
const jsonLd = data
	? {
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "BlogPosting",
					headline: title,
					...(description ? { description } : {}),
					inLanguage: "en",
					author: { "@type": "Person", name: PROFILE.name, url: SITE_URL },
					...(data.publishedAt
						? { datePublished: data.publishedAt }
						: {}),
					...(coverImage ? { image: absUrl(coverImage) } : {}),
					mainEntityOfPage: pageUrl,
				},
				{
					"@type": "BreadcrumbList",
					itemListElement: [
						{
							"@type": "ListItem",
							position: 1,
							name: "Home",
							item: SITE_URL,
						},
						{
							"@type": "ListItem",
							position: 2,
							name: t.allPosts,
							item: `${SITE_URL}/posts`,
						},
						{
							"@type": "ListItem",
							position: 3,
							name: title,
							item: pageUrl,
						},
					],
				},
			],
		}
	: null;
---

<Layout
	title={`${title} — Mahmudul Hasan Riaz`}
	description={description}
	ogType="article"
	ogImage={coverImage ? absUrl(coverImage) : null}
	canonical={pageUrl}
	lang={lang}
>
	{!entry || !data ? (
		<section class="glass">
			<a href={langUrl("/posts", lang)} class="back-link">
				{t.backAllPosts}
			</a>
			<h1 class="detail-title">{t.notFoundPost}</h1>
			<p class="empty-state">{t.notPublishedPost}</p>
		</section>
	) : (
		<section class="glass">
			{jsonLd ? (
				<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
			) : null}

			<a href={langUrl("/posts", lang)} class="back-link">
				{t.backAllPosts}
			</a>

			{thumb &&
				(isVideoThumb && videoSrc ? (
					<div class="detail-hero">
						<DetailVideoFacade
							src={videoSrc}
							poster={videoPoster}
							title={title}
							lang={lang}
							dict={t}
						/>
					</div>
				) : (
					<div class="detail-hero">
						<img src={thumb} alt={title} />
					</div>
				))}
			<h1 class="detail-title">{title}</h1>
			<p class="detail-meta">
				{t.authorBy} {PROFILE.name}
				{formatDate(data.publishedAt, lang)
					? ` · ${formatDate(data.publishedAt, lang)}`
					: ""}
				{readingTime ? ` · ${readingTimeLabel(readingTime, lang)}` : ""}
			</p>
			{tags.length ? (
				<div class="tag-row" style="margin-top:12px;">
					{tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			) : null}
			{description ? <p class="detail-lede">{description}</p> : null}

			{Content ? (
				<div class="detail-body">
					<Content />
				</div>
			) : storyBlocks.length > 0 ? (
				<div class="detail-body">
					{storyBlocks.map((block) =>
						block.kind === "h2" ? (
							<h2>{block.text}</h2>
						) : (
							<p>{block.text}</p>
						),
					)}
				</div>
			) : description ? (
				<div class="detail-body">
					<p>{description}</p>
				</div>
			) : null}

			<DetailMedia
				gallery={data.gallery ?? []}
				videos={data.videos ?? []}
				exclude={thumb}
				altBase={`${title} gallery image`}
			/>

			<div class="author-card">
				<img
					class="author-photo"
					src={PROFILE.photo}
					alt={PROFILE.name}
					width="56"
					height="56"
					loading="lazy"
				/>
				<div class="author-info">
					<strong>{PROFILE.name}</strong>
					<span>
						{t.authorLine}
					</span>
					<a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
				</div>
			</div>

			{related.length > 0 ? (
				<section class="section">
					<h2 class="detail-h2">{t.morePosts}</h2>
					<div class="card-grid">
						{related.map((r) => {
							const rt =
								r.data.readingTime ??
								readingTimeFromText(r.body) ??
								undefined;
							return (
								<a class="grid-card" href={langUrl(`/posts/${r.data.slug}`, lang)}>
									<div class="grid-body">
										<h3>{r.data.title}</h3>
										<p class="grid-meta">
											{formatDate(r.data.publishedAt, lang)}
											{rt ? ` · ${readingTimeLabel(rt, lang)}` : ""}
										</p>
									</div>
								</a>
							);
						})}
					</div>
				</section>
			) : null}

			<PrevNext
				prev={
					prev
						? {
								href: langUrl(`/posts/${prev.data.slug}`, lang),
								title: prev.data.title,
								thumb: thumbOf(prev),
							}
						: null
				}
				next={
					next
						? {
								href: langUrl(`/posts/${next.data.slug}`, lang),
								title: next.data.title,
								thumb: thumbOf(next),
							}
						: null
				}
				lang={lang}
				dict={t}
			/>
		</section>
	)}
</Layout>
