---
import Layout from "../../layouts/Layout.astro";
import BrandIcon from "../../components/BrandIcon.astro";
import DetailMedia from "../../components/DetailMedia.astro";
import PrevNext from "../../components/PrevNext.astro";
import ReleasePlayer from "../../components/ReleasePlayer";
import { getEntry, getLiveEntry } from "astro:content";
import { getReleases } from "../../lib/content";
import { youtubeEmbed, youtubeIdFromUrl, youtubeThumb } from "../../lib/youtube";
import {
	SITE_URL,
	absUrl,
	mergeDetail,
	platformActionLabel,
	yearOf,
} from "../../lib/detail";
import { PROFILE, WIKIMEDIA_LOGOS } from "../../data/site";

// On-demand detail route — hybrid live-then-static.
// Live entry first (Public Content API), then the build-time collection
// entry. After the next scheduled rebuild the page becomes a static file.
export const prerender = false;

const { slug } = Astro.params;
if (!slug) Astro.response.status = 404;

const liveResult = slug
	? await getLiveEntry("liveReleases", slug).catch(() => undefined)
	: undefined;
const liveEntry = liveResult?.entry;
if (liveEntry) Astro.cache.set(liveEntry);
const buildEntry = slug ? await getEntry("releases", slug) : undefined;
const entry = liveEntry ?? buildEntry;
if (!entry) Astro.response.status = 404;

interface ReleaseData {
	title?: string;
	description?: string;
	content?: string;
	releaseType?: string;
	publishedAt?: string;
	youtubeId?: string;
	platforms?: Array<{ name: string; url: string }>;
	tune?: string;
	lyricist?: string;
	lyrics?: string;
	thumbnail?: string;
	thumbnailType?: "image" | "video";
	thumbnailVideoUrl?: string;
	videos?: Array<{ url: string; title?: string }>;
}

const liveData = liveEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const buildData = buildEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const data = mergeDetail(buildData, liveData) as unknown as
	| ReleaseData
	| undefined;

const releases = await getReleases();
const idx = slug ? releases.findIndex((r) => r.data.slug === slug) : -1;
const prev = idx > 0 ? releases[idx - 1] : undefined;
const next =
	idx >= 0 && idx < releases.length - 1 ? releases[idx + 1] : undefined;
const thumbOf = (r: (typeof releases)[number] | undefined) =>
	r?.data.youtubeId ? youtubeThumb(r.data.youtubeId) : null;

const title = data?.title ?? "Release not published yet";
// Real description only — never the generic "A release by…" fallback.
const description = data?.description?.trim()
	? data.description
	: (data?.content?.trim() ? data.content : undefined);
const platforms = data?.platforms ?? [];
const youtubeId =
	data?.youtubeId ??
	youtubeIdFromUrl(
		platforms.find((p) => p.name === "YouTube")?.url,
	);
const hasYouTube = Boolean(youtubeId) || platforms.some((p) => p.name === "YouTube");
const isVideo = Boolean(youtubeId) && hasYouTube;
const coverImage = isVideo
	? youtubeThumb(youtubeId)
	: data?.thumbnail
		? absUrl(data.thumbnail)
		: null;
const firstPlatform = platforms[0];
const year = yearOf(data?.publishedAt);

const RELEASE_PLATFORM_ICONS: Record<string, string> = {
	YouTube: "youtube",
	Spotify: "spotify",
	"Apple Music": "applemusic",
	Deezer: "deezer",
	Boomplay: `wikimedia:${WIKIMEDIA_LOGOS.boomplay}`,
	JioSaavn: `wikimedia:${WIKIMEDIA_LOGOS.jiosaavn}`,
	SoundCloud: "soundcloud",
};

const pageUrl = `${SITE_URL}/releases/${slug}`;
const jsonLd = data
	? {
			"@context": "https://schema.org",
			"@graph": [
				isVideo && youtubeId
					? {
							"@type": "VideoObject",
							name: title,
							...(description ? { description } : {}),
							thumbnailUrl: youtubeThumb(youtubeId),
							...(data.publishedAt
								? { uploadDate: data.publishedAt }
								: {}),
							embedUrl: youtubeEmbed(youtubeId),
						}
					: {
							"@type": "AudioObject",
							name: title,
							...(description ? { description } : {}),
							...(data.publishedAt
								? { datePublished: data.publishedAt }
								: {}),
							...(firstPlatform
								? { contentUrl: firstPlatform.url }
								: {}),
							...(coverImage ? { thumbnailUrl: coverImage } : {}),
						},
				{
					"@type": "BreadcrumbList",
					itemListElement: [
						{
							"@type": "ListItem",
							position: 1,
							name: "Home",
							item: SITE_URL,
						},
						{
							"@type": "ListItem",
							position: 2,
							name: "Releases",
							item: `${SITE_URL}/releases`,
						},
						{
							"@type": "ListItem",
							position: 3,
							name: title,
							item: pageUrl,
						},
					],
				},
			],
		}
	: null;
---

<Layout
	title={`${title} — Mahmudul Hasan Riaz`}
	description={description}
	ogType="website"
	ogImage={coverImage}
	canonical={pageUrl}
>
	{!entry || !data ? (
		<section class="glass">
			<a href="/releases" class="back-link">
				← All releases
			</a>
			<h1 class="detail-title">Release not published yet</h1>
			<p class="empty-state">This release is not published yet.</p>
		</section>
	) : (
		<section class="glass">
			{jsonLd ? (
				<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
			) : null}

			<a href="/releases" class="back-link">
				← All releases
			</a>

			{isVideo && youtubeId ? (
				<ReleasePlayer client:load youtubeId={youtubeId} title={title} />
			) : data.thumbnail ? (
				<div class="detail-hero">
					<img src={data.thumbnail} alt={title} />
				</div>
			) : (
				<div class="audio-tile" aria-label="Audio release">
					{firstPlatform &&
					RELEASE_PLATFORM_ICONS[firstPlatform.name] ? (
						<BrandIcon
							icon={RELEASE_PLATFORM_ICONS[firstPlatform.name]}
							name={firstPlatform.name}
							size={64}
						/>
					) : (
						<svg
							width="64"
							height="64"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
							<path d="M19 10v2a7 7 0 0 1-14 0v-2" />
							<line x1="12" x2="12" y1="19" y2="22" />
						</svg>
					)}
				</div>
			)}
			<p class="detail-meta">
				{data.releaseType ? (
					<span class="type-tag">{data.releaseType}</span>
				) : null}
				{year ? ` · ${year}` : ""}
				{` · ${isVideo ? "Video" : "Audio"}`}
			</p>
			<h1 class="detail-title">{title}</h1>
			<p class="detail-meta">By {PROFILE.name}</p>
			{!isVideo ? (
				<p style="margin:12px 0 0;">
					<span class="audio-badge">Audio only — not on YouTube</span>
				</p>
			) : null}

			{description ? (
				<section class="detail-section" aria-label="About this release">
					<h2 class="detail-h2">About this release</h2>
					<div class="detail-body">
						<p>{description}</p>
					</div>
				</section>
			) : null}

			{data.tune || data.lyricist ? (
				<div class="credits-grid">
					{data.tune ? (
						<div class="credit">
							<div class="credit-label">Tune</div>
							<div class="credit-value">{data.tune}</div>
						</div>
					) : null}
					{data.lyricist ? (
						<div class="credit">
							<div class="credit-label">Lyricist</div>
							<div class="credit-value">{data.lyricist}</div>
						</div>
					) : null}
				</div>
			) : null}

			{data.lyrics ? (
				<section class="detail-section" aria-label="Lyrics">
					<h2 class="detail-h2">Lyrics</h2>
					<p class="lyrics">{data.lyrics}</p>
				</section>
			) : null}

			{platforms.length > 0 ? (
				<section class="detail-section" aria-label="Listen and watch">
					<h2 class="detail-h2">Listen &amp; watch</h2>
					<div class="platform-list">
						{platforms.map((p) => {
							const icon = RELEASE_PLATFORM_ICONS[p.name];
							return (
								<a
									class="platform-row-link"
									href={p.url}
									target="_blank"
									rel="noreferrer"
								>
									{icon ? (
										<BrandIcon icon={icon} name={p.name} size={22} />
									) : null}
									<span>{platformActionLabel(p.name)}</span>
									<span aria-hidden="true">↗</span>
								</a>
							);
						})}
					</div>
				</section>
			) : null}

			<DetailMedia videos={data.videos ?? []} altBase={`${title} video`} />

			<PrevNext
				prev={
					prev
						? {
								href: `/releases/${prev.data.slug}`,
								title: prev.data.title,
								thumb: thumbOf(prev),
							}
						: null
				}
				next={
					next
						? {
								href: `/releases/${next.data.slug}`,
								title: next.data.title,
								thumb: thumbOf(next),
							}
						: null
				}
			/>
		</section>
	)}
</Layout>
