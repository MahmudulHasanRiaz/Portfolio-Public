---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Stats from "../../components/Stats.astro";
import Services from "../../components/Services.astro";
import ProjectsCarousel from "../../components/ProjectsCarousel";
import StackGlobe from "../../components/StackGlobe";
import Combined from "../../components/Combined.astro";
import ClientsWall from "../../components/ClientsWall.astro";
import ContactForm from "../../components/ContactForm";
import { getProjects, getCaseStudies, getPosts, formatDate, readingTimeFromText, truncateShort } from "../../lib/content";
import { getDict, langUrl, localizeData, readingTimeLabel } from "../../lib/i18n";
import { PROFILE } from "../../data/site";

// Bangla homepage — same sections as the English homepage, in Bangla.
// Content rows are localised per-item (bn overlay, English fallback);
// fixed strings come from the dictionary. No auto-redirect anywhere:
// the visitor is here because the URL is /bn/ (or the first-visit
// script / switcher sent them here).
const lang = "bn" as const;
const t = getDict(lang);

const projectsRaw = await getProjects();
const projects = projectsRaw.map((p) => ({
	...p,
	data: localizeData(p.data, lang),
}));
const caseStudiesRaw = await getCaseStudies();
const caseStudies = caseStudiesRaw.map((cs) => ({
	...cs,
	data: localizeData(cs.data, lang),
}));
const postsRaw = await getPosts();
const posts = postsRaw.map((p) => ({
	...p,
	data: localizeData(p.data, lang),
}));

const carouselProjects = projects.map((p) => ({
	slug: p.data.slug,
	title: p.data.title,
	description: p.data.description ?? "",
	tags: p.data.tags ?? [],
	techs: p.data.techs ?? [],
	thumbnail: p.data.thumbnail ?? null,
	thumbnailType: p.data.thumbnailType ?? null,
}));

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: PROFILE.name,
	jobTitle: PROFILE.designations,
	url: "https://riaz.com.bd/",
	email: PROFILE.email,
	inLanguage: "bn",
	address: { "@type": "PostalAddress", addressLocality: "Dhaka", addressCountry: "BD" },
};
---

<Layout
	title={t.homeTitle}
	description={t.homeDescription}
	profile="se"
	lang={lang}
>
	<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

	<Hero profile="se" lang={lang} />

	<Stats lang={lang} />

	<Services lang={lang} />

	<section class="glass section" id="projects">
		<div class="section-head">
			<div>
				<h2>{t.projectsTitle}</h2>
				<p>{t.projectsSub}</p>
			</div>
			<a class="view-all" href={langUrl("/projects", lang)}>{t.viewAllProjects}</a>
		</div>
		{projects.length === 0 ? (
			<p class="empty-state">{t.emptyProjects}</p>
		) : (
			<ProjectsCarousel projects={carouselProjects} lang={lang} dict={t} client:load />
		)}
	</section>

	{
		caseStudies.length > 0 ? (
			<section class="glass section" id="case-studies">
				<div class="section-head">
					<div>
						<h2>{t.caseStudiesTitle}</h2>
						<p>{t.caseStudiesSub}</p>
					</div>
					<a class="view-all" href={langUrl("/case-studies", lang)}>
						{t.viewAllCaseStudies}
					</a>
				</div>
				<div class="card-grid">
					{caseStudies.map((cs) => (
						<a class="grid-card" href={langUrl(`/case-studies/${cs.data.slug}`, lang)}>
							<div class="grid-thumb">
								{cs.data.thumbnail ? (
									<img
										src={cs.data.thumbnail}
										alt={cs.data.title}
										loading="lazy"
									/>
								) : (
									<span class="thumb-fallback" aria-hidden="true">
										{cs.data.title.charAt(0)}
									</span>
								)}
							</div>
							<div class="grid-body">
								<h3>{cs.data.title}</h3>
								{cs.data.description ? <p>{truncateShort(cs.data.description)}</p> : null}
								<span class="service-cue">{t.readCaseStudy}
									<svg
										width="15"
										height="15"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<line x1="5" y1="12" x2="19" y2="12" />
										<polyline points="12 5 19 12 12 19" />
									</svg>
								</span>
							</div>
						</a>
					))}
				</div>
			</section>
		) : null
	}

	<StackGlobe lang={lang} dict={t} client:load />

	<Combined lang={lang} />

	<ClientsWall lang={lang} />

	<section class="glass section" id="posts">
		<div class="section-head">
			<div>
				<h2>{t.latestPostsTitle}</h2>
				<p>{t.latestPostsSub}</p>
			</div>
			<a class="view-all" href={langUrl("/posts", lang)}>{t.viewAllPosts}</a>
		</div>
		{posts.length === 0 ? (
			<p class="empty-state">{t.emptyPosts}</p>
		) : (
			<div class="card-grid">
				{posts.slice(0, 3).map((post) => {
					// Reading time is COMPUTED from the actual post text —
					// build-time markdown body first, live API `content`
					// second — never the stored value on its own.
					const postText =
						post.body ??
						(post.data as { content?: string }).content ??
						"";
					const readingTime =
						readingTimeFromText(postText) ??
						post.data.readingTime ??
						undefined;
					return (
						<a class="grid-card" href={langUrl(`/posts/${post.data.slug}`, lang)}>
							<div class="grid-thumb">
								{post.data.thumbnail ? (
									<img
										src={post.data.thumbnail}
										alt={post.data.title}
										loading="lazy"
									/>
								) : (
									<span class="thumb-fallback" aria-hidden="true">
										{post.data.title.charAt(0)}
									</span>
								)}
							</div>
							<div class="grid-body">
								{post.data.tags?.[0] ? (
									<div class="tag-row">
										<span class="tag">{post.data.tags[0]}</span>
									</div>
								) : null}
								<h3>{post.data.title}</h3>
								<p class="grid-meta">
									{formatDate(post.data.publishedAt, lang)}
									{readingTime ? ` · ${readingTimeLabel(readingTime, lang)}` : ""}
								</p>
							</div>
						</a>
					);
				})}
			</div>
		)}
	</section>

	<section class="glass section" id="contact">
		<div style="text-align:center;">
			<h2 style="margin:0;font-size:24px;line-height:1.3;letter-spacing:-0.01em;">
				{t.contactTitle}
			</h2>
			<p
				class="muted"
				style="margin:8px auto 0;max-width:520px;font-size:15px;"
			>
				{t.contactSub}
			</p>
		</div>
		<div style="max-width:520px;margin:24px auto 0;">
			<ContactForm inline source="homepage-contact" lang={lang} dict={t} client:load />
		</div>
	</section>
</Layout>
