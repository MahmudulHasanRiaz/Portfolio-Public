---
import Layout from "../../../layouts/Layout.astro";
import BrandIcon from "../../../components/BrandIcon.astro";
import DetailMedia from "../../../components/DetailMedia.astro";
import DetailVideoFacade from "../../../components/DetailVideoFacade.astro";
import PrevNext from "../../../components/PrevNext.astro";
import ReleasePlayer from "../../../components/ReleasePlayer";
import { getCollection, getEntry, getLiveEntry } from "astro:content";
import { createPublicContentLoader } from "../../../loaders/public-content";
import { getReleases } from "../../../lib/content";
import { youtubeEmbed, youtubeIdFromUrl, youtubeThumb } from "../../../lib/youtube";
import {
	resolveSiteUrl,
	absUrl,
	mergeDetail,
	yearOf,
} from "../../../lib/detail";
import { PROFILE, WIKIMEDIA_LOGOS } from "../../../data/site";
import { applySiteCopy, getDict, langUrl, localizeData, pickDict, RELEASE_PLAYER_DICT_KEYS, platformActionLabelLang } from "../../../lib/i18n";
import { getSiteSettings } from "../../../lib/settings";

// Bangla static detail route — same hybrid as the English route.
// Bangla fields come from the item's optional nested `bn` object (live
// API or build-time frontmatter); English is the fallback, never a blank.
// Static detail route — hybrid live-then-static, ISSUE 7A (plan §2):
// known slugs are prerendered at build time, so a click serves static
// HTML from the edge instead of waiting on the Worker → slow VPS API
// (~2.2s TTFB). The body still prefers the live entry when the API is
// reachable at build time, then the build-time row, then a 404.
// Route caching is in astro.config.mjs.
// NOTE: `export const prerender = false` was REMOVED on purpose —
// Astro only calls getStaticPaths() for prerendered routes, so keeping
// it made getStaticPaths dead code (no static files were ever built).
// Trade-off: a slug published after the build 404s until the next
// rebuild — the on-demand fallback for new slugs needs a twin SSR
// route with the same pattern (Astro serves the static file when one
// exists and falls through to the SSR route otherwise).
export async function getStaticPaths() {
	// Slugs from the build-time collection AND the live API. When the
	// live API is unreachable at build time, fall back to build-time
	// slugs only — the build never fails on the live API.
	const slugs = new Set<string>();
	for (const entry of await getCollection("releases")) {
		slugs.add(entry.data.slug);
	}
	try {
		const { entries } = await createPublicContentLoader(
			"releases",
		).loadCollection();
		for (const entry of entries) {
			const slug =
				typeof entry.data.slug === "string" ? entry.data.slug : entry.id;
			if (slug) slugs.add(slug);
		}
	} catch {
		// Live API unreachable at build time — build-time slugs only.
	}
	return [...slugs].map((slug) => ({ params: { slug } }));
}

const lang = "bn" as const;
const settings = await getSiteSettings();
const t = applySiteCopy(getDict(lang), lang, settings);

const { slug } = Astro.params;
if (!slug) Astro.response.status = 404;

const liveResult = slug
	? await getLiveEntry("liveReleases", slug).catch(() => undefined)
	: undefined;
const liveEntry = liveResult?.entry;
if (liveEntry) Astro.cache.set(liveEntry);
const buildEntry = slug ? await getEntry("releases", slug) : undefined;
const entry = liveEntry ?? buildEntry;
if (!entry) Astro.response.status = 404;

interface ReleaseData {
	title?: string;
	description?: string;
	content?: string;
	releaseType?: string;
	publishedAt?: string;
	youtubeId?: string;
	platforms?: Array<{ name: string; url: string }>;
	tune?: string;
	lyricist?: string;
	lyrics?: string;
	thumbnail?: string;
	thumbnailType?: "image" | "video";
	thumbnailVideoUrl?: string;
	videos?: Array<{ url: string; title?: string }>;
}

const liveData = liveEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const buildData = buildEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const merged = mergeDetail(buildData, liveData) as unknown as
	| ReleaseData
	| undefined;
const data = merged
	? (localizeData(
			merged as unknown as Record<string, unknown>,
			lang,
		) as unknown as ReleaseData)
	: undefined;

const releasesRaw = await getReleases();
const releases = releasesRaw.map((r) => ({
	...r,
	data: localizeData(r.data, lang),
}));
const idx = slug ? releases.findIndex((r) => r.data.slug === slug) : -1;
const prev = idx > 0 ? releases[idx - 1] : undefined;
const next =
	idx >= 0 && idx < releases.length - 1 ? releases[idx + 1] : undefined;
const thumbOf = (r: (typeof releases)[number] | undefined) =>
	r?.data.youtubeId ? youtubeThumb(r.data.youtubeId) : null;

const title = data?.title ?? t.notFoundRelease;
// Real description only — never the generic "A release by…" fallback.
const description = data?.description?.trim()
	? data.description
	: (data?.content?.trim() ? data.content : undefined);
const platforms = data?.platforms ?? [];
const youtubeId =
	data?.youtubeId ??
	youtubeIdFromUrl(
		platforms.find((p) => p.name === "YouTube")?.url,
	);
const hasYouTube = Boolean(youtubeId) || platforms.some((p) => p.name === "YouTube");
const isVideo = Boolean(youtubeId) && hasYouTube;
const coverImage = isVideo
	? youtubeThumb(youtubeId)
	: data?.thumbnail
		? absUrl(data.thumbnail)
		: null;
const firstPlatform = platforms[0];
const year = yearOf(data?.publishedAt);

const releaseTypeLabel = (() => {
	const key = (data?.releaseType ?? "").toLowerCase();
	if (key === "nasheed") return t.releaseTypeNasheed;
	if (key === "tilawat") return t.releaseTypeTilawat;
	if (key === "podcast") return t.releaseTypePodcast;
	if (key === "lecture") return t.releaseTypeLecture;
	if (key === "other") return t.releaseTypeOther;
	return data?.releaseType ?? "";
})();

const RELEASE_PLATFORM_ICONS: Record<string, string> = {
	YouTube: "youtube",
	Spotify: "spotify",
	"Apple Music": "applemusic",
	Deezer: "deezer",
	Boomplay: `wikimedia:${WIKIMEDIA_LOGOS.boomplay}`,
	JioSaavn: `wikimedia:${WIKIMEDIA_LOGOS.jiosaavn}`,
	SoundCloud: "soundcloud",
};

// Canonical base: the admin site_url setting wins; resolveSiteUrl()
// falls back to the live workers.dev base when it is absent/invalid.
const siteBase = resolveSiteUrl(settings.siteUrl);
const pageUrl = `${siteBase}/bn/releases/${slug}`;
const jsonLd = data
	? {
			"@context": "https://schema.org",
			"@graph": [
				isVideo && youtubeId
					? {
							"@type": "VideoObject",
							name: title,
							...(description ? { description } : {}),
							inLanguage: "bn",
							thumbnailUrl: youtubeThumb(youtubeId),
							...(data.publishedAt
								? { uploadDate: data.publishedAt }
								: {}),
							embedUrl: youtubeEmbed(youtubeId),
						}
					: {
							"@type": "AudioObject",
							name: title,
							...(description ? { description } : {}),
							inLanguage: "bn",
							...(data.publishedAt
								? { datePublished: data.publishedAt }
								: {}),
							...(firstPlatform
								? { contentUrl: firstPlatform.url }
								: {}),
							...(coverImage ? { thumbnailUrl: coverImage } : {}),
						},
				{
					"@type": "BreadcrumbList",
					itemListElement: [
						{
							"@type": "ListItem",
							position: 1,
							name: "হোম",
							item: siteBase,
						},
						{
							"@type": "ListItem",
							position: 2,
							name: t.allReleases,
							item: `${siteBase}/bn/releases`,
						},
						{
							"@type": "ListItem",
							position: 3,
							name: title,
							item: pageUrl,
						},
					],
				},
			],
		}
	: null;
---

<Layout
	title={`${title} — Mahmudul Hasan Riaz`}
	description={description}
	ogType="website"
	ogImage={coverImage}
	canonical={pageUrl}
	lang={lang}
>
	{!entry || !data ? (
		<section class="glass">
			<a href={langUrl("/releases", lang)} class="back-link">
				{t.backAllReleases}
			</a>
			<h1 class="detail-title">{t.notFoundRelease}</h1>
			<p class="empty-state">{t.notPublishedRelease}</p>
		</section>
	) : (
		<section class="glass">
			{jsonLd ? (
				<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
			) : null}

			<a href={langUrl("/releases", lang)} class="back-link">
				{t.backAllReleases}
			</a>

			{isVideo && youtubeId ? (
				<ReleasePlayer client:load youtubeId={youtubeId} title={title} lang={lang} dict={pickDict(t, RELEASE_PLAYER_DICT_KEYS)} />
			) : data.thumbnailType === "video" && data.thumbnail ? (
				<div class="detail-hero">
					<DetailVideoFacade
						src={data.thumbnail}
						poster={null}
						title={title}
						lang={lang}
						dict={t}
					/>
				</div>
			) : data.thumbnail ? (
				<div class="detail-hero">
					<img src={data.thumbnail} alt={title} />
				</div>
			) : (
				<div class="audio-tile" aria-label={t.audioRelease}>
					{firstPlatform &&
					RELEASE_PLATFORM_ICONS[firstPlatform.name] ? (
						<BrandIcon
							icon={RELEASE_PLATFORM_ICONS[firstPlatform.name]}
							name={firstPlatform.name}
							size={64}
						/>
					) : (
						<svg
							width="64"
							height="64"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
							<path d="M19 10v2a7 7 0 0 1-14 0v-2" />
							<line x1="12" x2="12" y1="19" y2="22" />
						</svg>
					)}
				</div>
			)}
			<p class="detail-meta">
				{releaseTypeLabel ? (
					<span class="type-tag">{releaseTypeLabel}</span>
				) : null}
				{year ? ` · ${year}` : ""}
				{` · ${isVideo ? t.videoLabel : t.audioLabel}`}
			</p>
			<h1 class="detail-title">{title}</h1>
			<p class="detail-meta">{t.authorBy} {PROFILE.name}</p>
			{!isVideo ? (
				<p style="margin:12px 0 0;">
					<span class="audio-badge">{t.audioOnly}</span>
				</p>
			) : null}

			{description ? (
				<section class="detail-section" aria-label={t.aboutRelease}>
					<h2 class="detail-h2">{t.aboutRelease}</h2>
					<div class="detail-body">
						<p>{description}</p>
					</div>
				</section>
			) : null}

			{data.tune || data.lyricist ? (
				<div class="credits-grid">
					{data.tune ? (
						<div class="credit">
							<div class="credit-label">{t.tune}</div>
							<div class="credit-value">{data.tune}</div>
						</div>
					) : null}
					{data.lyricist ? (
						<div class="credit">
							<div class="credit-label">{t.lyricist}</div>
							<div class="credit-value">{data.lyricist}</div>
						</div>
					) : null}
				</div>
			) : null}

			{data.lyrics ? (
				<section class="detail-section" aria-label={t.lyrics}>
					<h2 class="detail-h2">{t.lyrics}</h2>
					<p class="lyrics">{data.lyrics}</p>
				</section>
			) : null}

			{platforms.length > 0 ? (
				<section class="detail-section" aria-label={t.listenWatch}>
					<h2 class="detail-h2">{t.listenWatch}</h2>
					<div class="platform-list">
						{platforms.map((p) => {
							const icon = RELEASE_PLATFORM_ICONS[p.name];
							return (
								<a
									class="platform-row-link"
									href={p.url}
									target="_blank"
									rel="noreferrer"
								>
									{icon ? (
										<BrandIcon icon={icon} name={p.name} size={22} />
									) : null}
									<span>{platformActionLabelLang(p.name, lang)}</span>
									<span aria-hidden="true">↗</span>
								</a>
							);
						})}
					</div>
				</section>
			) : null}

			<DetailMedia lang={lang} dict={t} videos={data.videos ?? []} altBase={`${title} video`} />

			<PrevNext
				prev={
					prev
						? {
								href: langUrl(`/releases/${prev.data.slug}`, lang),
								title: prev.data.title,
								thumb: thumbOf(prev),
							}
						: null
				}
				next={
					next
						? {
								href: langUrl(`/releases/${next.data.slug}`, lang),
								title: next.data.title,
								thumb: thumbOf(next),
							}
						: null
				}
				lang={lang}
				dict={t}
			/>
		</section>
	)}
</Layout>
