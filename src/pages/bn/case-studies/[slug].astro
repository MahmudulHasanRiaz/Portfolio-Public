---
import Layout from "../../../layouts/Layout.astro";
import { getEntry, getLiveEntry } from "astro:content";
import DetailCta from "../../../components/DetailCta.astro";
import DetailMedia from "../../../components/DetailMedia.astro";
import DetailVideoFacade from "../../../components/DetailVideoFacade.astro";
import KeyStrip from "../../../components/KeyStrip.astro";
import MarkdownBody from "../../../components/MarkdownBody.astro";
import PrevNext from "../../../components/PrevNext.astro";
import TechChips from "../../../components/TechChips.astro";
import { formatDate, getCaseStudies, getProjects } from "../../../lib/content";
import {
	SITE_URL,
	absUrl,
	dedupeBlocks,
	mergeDetail,
	parseBodyBlocks,
} from "../../../lib/detail";
import { getDict, langUrl, localizeData } from "../../../lib/i18n";

// Bangla on-demand detail route — hybrid live-then-static: the live
// collection first (instant when a case study is newly published), then
// the build-time collection as fallback, then a 404.
export const prerender = false;

const lang = "bn" as const;
const t = getDict(lang);

const { slug } = Astro.params;
const liveResult = slug
	? await getLiveEntry("liveCaseStudies", slug).catch(() => undefined)
	: undefined;
const liveEntry = liveResult?.entry;
if (liveEntry) Astro.cache.set(liveEntry);
const buildEntry = slug ? await getEntry("caseStudies", slug) : undefined;
const entry = liveEntry ?? buildEntry;
if (!entry) Astro.response.status = 404;

interface Metric {
	value: string;
	label: string;
}

interface CaseStudyData {
	title: string;
	description?: string;
	content?: string;
	tags?: string[];
	publishedAt?: string;
	thumbnail?: string;
	thumbnailType?: "image" | "video";
	thumbnailVideoUrl?: string;
	problem?: string;
	fix?: string;
	result?: string;
	fixPoints?: string[];
	metrics?: Metric[];
	research?: string;
	techs?: string[];
	projectSlug?: string;
	gallery?: string[];
	videos?: { url: string; title?: string }[];
}

const liveData = liveEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const buildData = buildEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const merged = mergeDetail(buildData, liveData) as unknown as
	| CaseStudyData
	| undefined;
const d = merged
	? (localizeData(
			merged as unknown as Record<string, unknown>,
			lang,
		) as unknown as CaseStudyData)
	: undefined;

// A Bangla body (bn.content) wins over the English body.
const bnRaw = (merged as unknown as Record<string, unknown> | undefined)?.[
	"bn"
] as Record<string, unknown> | undefined;
const bnContent =
	typeof bnRaw?.content === "string" && bnRaw.content
		? bnRaw.content
		: undefined;

// The story body, rendered ONCE: the Bangla content when present, else
// the live content string, else the build-time markdown body. Any
// paragraph that merely restates the Problem / Fix / Result fields
// is dropped, so each section appears exactly once. What survives is
// the hook lede.
const rawBody = bnContent ?? d?.content ?? buildEntry?.body ?? "";
const ledeBlocks = dedupeBlocks(parseBodyBlocks(rawBody), [
	d?.problem,
	d?.fix,
	d?.result,
	d?.description,
]);

// "Built with" techs: the case study's own list when present, else the
// linked project's stack (real data, never invented).
let techs = d?.techs ?? [];
if (techs.length === 0 && d?.projectSlug) {
	const projects = await getProjects();
	const linked = projects.find((p) => p.data.slug === d.projectSlug);
	if (linked?.data.techs?.length) techs = linked.data.techs;
}

const isVideoThumb = d?.thumbnailType === "video";
const videoSrc = isVideoThumb
	? (d?.thumbnailVideoUrl ?? d?.thumbnail)
	: undefined;
const videoPoster =
	isVideoThumb && d?.thumbnailVideoUrl ? (d?.thumbnail ?? null) : null;
const coverImage = !isVideoThumb && d?.thumbnail ? d.thumbnail : videoPoster;

// Prev/next by date order (newest first): prev = older, next = newer.
const allStudiesRaw = await getCaseStudies();
const allStudies = allStudiesRaw.map((s) => ({
	...s,
	data: localizeData(s.data, lang),
}));
const currentIndex = allStudies.findIndex((s) => s.data.slug === slug);
const prevStudy = currentIndex >= 0 ? allStudies[currentIndex + 1] : undefined;
const nextStudy = currentIndex > 0 ? allStudies[currentIndex - 1] : undefined;
const thumbOf = (s: (typeof allStudies)[number] | undefined) =>
	s?.data.thumbnailType !== "video" && s?.data.thumbnail
		? s.data.thumbnail
		: null;

const pageUrl = `${SITE_URL}/bn/case-studies/${slug}`;
const jsonLd = d
	? {
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "Article",
					headline: d.title,
					description: d.description,
					inLanguage: "bn",
					author: {
						"@type": "Person",
						name: "Mahmudul Hasan Riaz",
						url: SITE_URL,
					},
					mainEntityOfPage: pageUrl,
					...(coverImage ? { image: absUrl(coverImage) } : {}),
				},
				{
					"@type": "BreadcrumbList",
					itemListElement: [
						{
							"@type": "ListItem",
							position: 1,
							name: "হোম",
							item: SITE_URL,
						},
						{
							"@type": "ListItem",
							position: 2,
							name: t.allCaseStudies,
							item: `${SITE_URL}/bn/case-studies`,
						},
						{
							"@type": "ListItem",
							position: 3,
							name: d.title,
							item: pageUrl,
						},
					],
				},
			],
		}
	: null;
---

<Layout
	title={
		d
			? `${d.title} — Mahmudul Hasan Riaz`
			: `${t.notFoundCaseStudy} — Mahmudul Hasan Riaz`
	}
	description={d?.description}
	ogType="article"
	ogImage={coverImage ? absUrl(coverImage) : null}
	canonical={pageUrl}
	lang={lang}
>
	{
		entry && d ? (
			<section class="glass">
				{jsonLd && (
					<script
						type="application/ld+json"
						set:html={JSON.stringify(jsonLd)}
					/>
				)}

				<a class="back-link" href={langUrl("/case-studies", lang)}>
					{t.backAllCaseStudies}
				</a>
				{d.thumbnail &&
					(isVideoThumb && videoSrc ? (
						<div class="detail-hero">
							<DetailVideoFacade
								src={videoSrc}
								poster={videoPoster}
								title={d.title}
								lang={lang}
								dict={t}
							/>
						</div>
					) : (
						<div class="detail-hero">
							<img src={d.thumbnail} alt={d.title} />
						</div>
					))}
				<h1 class="detail-title">{d.title}</h1>
				{d.tags?.length ? (
					<div class="tag-row" style="margin-top:12px;">
						{d.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				) : null}
				<KeyStrip
					items={[
						{
							label: t.publishedLabel,
							value: formatDate(d.publishedAt, lang),
						},
						d.tags?.length
							? { label: t.categoryLabel, value: d.tags.join(", ") }
							: null,
						d.projectSlug
							? {
									label: t.projectLabel,
									value: t.viewProject,
									href: langUrl(`/projects/${d.projectSlug}`, lang),
								}
							: null,
					]}
				/>
				{ledeBlocks.length > 0 ? (
					<MarkdownBody blocks={ledeBlocks} />
				) : null}
				{(d.problem || d.fix || d.result) && (
					<div class="problem-fix-result">
						{d.problem && (
							<div class="pfr">
								<h3>{t.problem}</h3>
								<p>{d.problem}</p>
							</div>
						)}
						{d.fix && (
							<div class="pfr">
								<h3>{t.fix}</h3>
								<p>{d.fix}</p>
								{d.fixPoints?.length ? (
									<ul class="fix-points">
										{d.fixPoints.map((point) => (
											<li>{point}</li>
										))}
									</ul>
								) : null}
							</div>
						)}
						{d.result && (
							<div class="pfr">
								<h3>{t.result}</h3>
								<p>{d.result}</p>
							</div>
						)}
					</div>
				)}
				{d.metrics?.length ? (
					<div class="metrics-band" aria-label={t.result}>
						{d.metrics.map((metric) => (
							<div class="metric-card">
								<strong>{metric.value}</strong>
								<span>{metric.label}</span>
							</div>
						))}
					</div>
				) : null}
				{d.research ? (
					<section class="detail-section" aria-label={t.research}>
						<h2 class="detail-h2">{t.research}</h2>
						<MarkdownBody text={d.research} />
					</section>
				) : null}
				<TechChips techs={techs} lang={lang} dict={t} />
				<DetailMedia
					gallery={d.gallery ?? []}
					videos={d.videos ?? []}
					exclude={d.thumbnail}
					altBase={`${d.title} gallery image`}
				/>
				<DetailCta
					title={t.facingSimilar}
					text={t.caseStudyCtaText}
					buttonLabel={t.discussSimilarProject}
					linkHref={
						d.projectSlug
							? langUrl(`/projects/${d.projectSlug}?from=case-study:${slug}`, lang)
							: undefined
					}
					linkLabel={d.projectSlug ? t.viewProject : undefined}
					source="case-study-detail"
					lang={lang}
					dict={t}
				/>
				<PrevNext
					prev={
						prevStudy
							? {
									href: langUrl(`/case-studies/${prevStudy.data.slug}`, lang),
									title: prevStudy.data.title,
									thumb: thumbOf(prevStudy),
								}
							: null
					}
					next={
						nextStudy
							? {
									href: langUrl(`/case-studies/${nextStudy.data.slug}`, lang),
									title: nextStudy.data.title,
									thumb: thumbOf(nextStudy),
								}
							: null
					}
					lang={lang}
					dict={t}
				/>
			</section>
		) : (
			<section class="glass">
				<a class="back-link" href={langUrl("/case-studies", lang)}>
					{t.backAllCaseStudies}
				</a>
				<h1 class="detail-title">{t.notFoundCaseStudy}</h1>
				<p class="empty-state">{t.notPublishedCaseStudy}</p>
			</section>
		)
	}
</Layout>
