---
import Layout from "../../../layouts/Layout.astro";
import DetailCta from "../../../components/DetailCta.astro";
import DetailMedia from "../../../components/DetailMedia.astro";
import DetailVideoFacade from "../../../components/DetailVideoFacade.astro";
import KeyStrip from "../../../components/KeyStrip.astro";
import MarkdownBody from "../../../components/MarkdownBody.astro";
import PrevNext from "../../../components/PrevNext.astro";
import { getEntry, getLiveEntry } from "astro:content";
import { getVentures, formatDate } from "../../../lib/content";
import {
	SITE_URL,
	absUrl,
	dedupeBlocks,
	isRealUrl,
	mergeDetail,
	parseBodyBlocks,
} from "../../../lib/detail";
import { PROFILE } from "../../../data/site";
import { getDict, langUrl, localizeData } from "../../../lib/i18n";

// Bangla on-demand detail route — hybrid live-then-static.
// Live entry first (Public Content API), then the build-time collection
// entry. After the next scheduled rebuild the page becomes a static file.
export const prerender = false;

const lang = "bn" as const;
const t = getDict(lang);

const { slug } = Astro.params;
if (!slug) Astro.response.status = 404;

const liveResult = slug
	? await getLiveEntry("liveVentures", slug).catch(() => undefined)
	: undefined;
const liveEntry = liveResult?.entry;
if (liveEntry) Astro.cache.set(liveEntry);
const buildEntry = slug ? await getEntry("ventures", slug) : undefined;
const entry = liveEntry ?? buildEntry;
if (!entry) Astro.response.status = 404;

interface Metric {
	value: string;
	label: string;
}

interface VentureData {
	title?: string;
	description?: string;
	content?: string;
	tags?: string[];
	publishedAt?: string;
	thumbnail?: string;
	thumbnailType?: "image" | "video";
	thumbnailVideoUrl?: string;
	website?: string | null;
	gallery?: string[];
	videos?: Array<{ url: string; title?: string }>;
	stage?: string;
	location?: string;
	teamSize?: string;
	foundedDate?: string;
	metrics?: Metric[];
}

const liveData = liveEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const buildData = buildEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const merged = mergeDetail(buildData, liveData) as unknown as
	| VentureData
	| undefined;
const data = merged
	? (localizeData(
			merged as unknown as Record<string, unknown>,
			lang,
		) as unknown as VentureData)
	: undefined;

// A Bangla body (bn.content) wins over the English body.
const bnRaw = (merged as unknown as Record<string, unknown> | undefined)?.[
	"bn"
] as Record<string, unknown> | undefined;
const bnContent =
	typeof bnRaw?.content === "string" && bnRaw.content
		? bnRaw.content
		: undefined;

// The body is the long description — never the one-liner repeated: any
// paragraph that restates the description is dropped (the live
// duplication bug — the same line rendered as subtitle AND as body).
const rawBody = bnContent ?? data?.content ?? buildEntry?.body ?? "";
const bodyBlocks = dedupeBlocks(parseBodyBlocks(rawBody), [
	data?.description,
]);

const venturesRaw = await getVentures();
const ventures = venturesRaw.map((v) => ({
	...v,
	data: localizeData(v.data, lang),
}));
const idx = slug ? ventures.findIndex((v) => v.data.slug === slug) : -1;
const prev = idx > 0 ? ventures[idx - 1] : undefined;
const next =
	idx >= 0 && idx < ventures.length - 1 ? ventures[idx + 1] : undefined;
const thumbOf = (v: (typeof ventures)[number] | undefined) =>
	v?.data.thumbnailType !== "video" && v?.data.thumbnail
		? v.data.thumbnail
		: null;

const title = data?.title ?? t.notFoundVenture;
const description = data?.description;
const tags = data?.tags ?? [];
const website = isRealUrl(data?.website) ? data.website : null;

const isVideoThumb = data?.thumbnailType === "video";
const videoSrc = isVideoThumb
	? (data?.thumbnailVideoUrl ?? data?.thumbnail)
	: undefined;
const videoPoster =
	isVideoThumb && data?.thumbnailVideoUrl ? (data?.thumbnail ?? null) : null;
const coverImage =
	!isVideoThumb && data?.thumbnail ? data.thumbnail : videoPoster;

const pageUrl = `${SITE_URL}/bn/ventures/${slug}`;
const jsonLd = data
	? {
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "Organization",
					name: title,
					...(description ? { description } : {}),
					inLanguage: "bn",
					...(website ? { url: website } : {}),
					founder: { "@type": "Person", name: PROFILE.name },
				},
				{
					"@type": "BreadcrumbList",
					itemListElement: [
						{
							"@type": "ListItem",
							position: 1,
							name: "হোম",
							item: SITE_URL,
						},
						{
							"@type": "ListItem",
							position: 2,
							name: t.allVentures,
							item: `${SITE_URL}/bn/ventures`,
						},
						{
							"@type": "ListItem",
							position: 3,
							name: title,
							item: pageUrl,
						},
					],
				},
			],
		}
	: null;
---

<Layout
	title={`${title} — Mahmudul Hasan Riaz`}
	description={description}
	ogType="website"
	ogImage={coverImage ? absUrl(coverImage) : null}
	canonical={pageUrl}
	lang={lang}
>
	{!entry || !data ? (
		<section class="glass">
			<a class="back-link" href={langUrl("/ventures", lang)}>
				{t.backAllVentures}
			</a>
			<h1 class="detail-title">{t.notFoundVenture}</h1>
			<p class="empty-state">{t.notPublishedVenture}</p>
		</section>
	) : (
		<section class="glass">
			{jsonLd ? (
				<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
			) : null}

			<a href={langUrl("/ventures", lang)} class="back-link">
				{t.backAllVentures}
			</a>

			{data.thumbnail &&
				(isVideoThumb && videoSrc ? (
					<div class="detail-hero">
						<DetailVideoFacade
							src={videoSrc}
							poster={videoPoster}
							title={title}
							lang={lang}
							dict={t}
						/>
					</div>
				) : (
					<div class="detail-hero">
						<img src={data.thumbnail} alt={title} />
					</div>
				))}
			<h1 class="detail-title">{title}</h1>
			{tags.length ? (
				<div class="tag-row" style="margin-top:12px;">
					{tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			) : null}
			{description ? <p class="detail-lede">{description}</p> : null}

			<KeyStrip
				items={[
					{
						label: t.publishedLabel,
						value: formatDate(data.publishedAt, lang),
					},
					data.stage ? { label: t.stageLabel, value: data.stage } : null,
					data.location
						? { label: t.locationLabel, value: data.location }
						: null,
					data.teamSize
						? { label: t.teamSizeLabel, value: data.teamSize }
						: null,
					data.foundedDate
						? {
								label: t.foundedLabel,
								value: formatDate(data.foundedDate, lang),
							}
						: null,
					tags.length
						? { label: t.categoryLabel, value: tags.join(", ") }
						: null,
					website
						? { label: t.websiteLabel, value: t.visitWebsite, href: website }
						: null,
				]}
			/>

			{data.metrics?.length ? (
				<div class="metrics-band" aria-label={t.allVentures}>
					{data.metrics.map((metric) => (
						<div class="metric-card">
							<strong>{metric.value}</strong>
							<span>{metric.label}</span>
						</div>
					))}
				</div>
			) : null}

			{bodyBlocks.length > 0 ? (
				<section class="detail-section" aria-label={`${t.aboutVenture} ${title}`}>
					<h2 class="detail-h2">{t.aboutVenture} {title}</h2>
					<MarkdownBody blocks={bodyBlocks} />
				</section>
			) : null}

			<DetailMedia
				gallery={data.gallery ?? []}
				videos={data.videos ?? []}
				exclude={data.thumbnail}
				altBase={`${title} gallery image`}
			/>

			<DetailCta
				title={`${t.thinkingVenture} ${title}?`}
				text={t.ventureCtaText}
				buttonLabel={t.discussSimilarVenture}
				source="venture-detail"
				lang={lang}
				dict={t}
			/>

			<PrevNext
				prev={
					prev
						? {
								href: langUrl(`/ventures/${prev.data.slug}`, lang),
								title: prev.data.title,
								thumb: thumbOf(prev),
							}
						: null
				}
				next={
					next
						? {
								href: langUrl(`/ventures/${next.data.slug}`, lang),
								title: next.data.title,
								thumb: thumbOf(next),
							}
						: null
				}
				lang={lang}
				dict={t}
			/>
		</section>
	)}
</Layout>
