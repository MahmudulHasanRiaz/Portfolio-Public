---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Services from "../components/Services.astro";
import ProjectsCarousel from "../components/ProjectsCarousel";
import StackGlobe from "../components/StackGlobe";
import Combined from "../components/Combined.astro";
import ClientsWall from "../components/ClientsWall.astro";
import ContactForm from "../components/ContactForm";
import { getProjects, getCaseStudies, getPosts, formatDate, readingTimeFromText } from "../lib/content";
import { PROFILE } from "../data/site";

// Software Engineer profile — the conversion-focused homepage.
// Order: Hero → Stats → Services → Projects → Case studies → Stack →
// Combined "Beyond the code" → Clients → Latest posts → Contact → Footer.
// (There is no separate Ventures or Releases section here — both live
// inside Combined as mini-rows/chips, and in full on the Know Me page.)
const projects = await getProjects();
const caseStudies = await getCaseStudies();
const posts = await getPosts();

const carouselProjects = projects.map((p) => ({
	slug: p.data.slug,
	title: p.data.title,
	description: p.data.description ?? "",
	tags: p.data.tags ?? [],
	techs: p.data.techs ?? [],
	thumbnail: p.data.thumbnail ?? null,
	thumbnailType: p.data.thumbnailType ?? null,
}));

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: PROFILE.name,
	jobTitle: PROFILE.designations,
	url: "https://riaz.com.bd/",
	email: PROFILE.email,
	address: { "@type": "PostalAddress", addressLocality: "Dhaka", addressCountry: "BD" },
};
---

<Layout
	title="Mahmudul Hasan Riaz — Software Engineer, Entrepreneur & Nasheed Artist"
	description="Software Engineer, Entrepreneur and Nasheed Artist from Dhaka, Bangladesh. ERP, e-commerce and SaaS systems for businesses in Bangladesh and beyond."
	profile="se"
>
	<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

	<Hero profile="se" />

	<Stats />

	<Services />

	<section class="glass section" id="projects">
		<div class="section-head">
			<div>
				<h2>Projects</h2>
				<p>Selected work — real systems running real businesses.</p>
			</div>
			<a class="view-all" href="/projects">View all projects →</a>
		</div>
		{projects.length === 0 ? (
			<p class="empty-state">No projects published yet.</p>
		) : (
			<ProjectsCarousel projects={carouselProjects} client:load />
		)}
	</section>

	{
		caseStudies.length > 0 ? (
			<section class="glass section" id="case-studies">
				<div class="section-head">
					<div>
						<h2>Case studies</h2>
						<p>The problem, the fix, the result — in one line each. Tap a case study to read the full story.</p>
					</div>
					<a class="view-all" href="/case-studies">
						View all case studies →
					</a>
				</div>
				<div class="card-grid">
					{caseStudies.map((cs) => (
						<a class="grid-card" href={`/case-studies/${cs.data.slug}`}>
							<div class="grid-thumb">
								{cs.data.thumbnail ? (
									<img
										src={cs.data.thumbnail}
										alt={cs.data.title}
										loading="lazy"
									/>
								) : (
									<span class="thumb-fallback" aria-hidden="true">
										{cs.data.title.charAt(0)}
									</span>
								)}
							</div>
							<div class="grid-body">
								<h3>{cs.data.title}</h3>
								{cs.data.description ? <p>{cs.data.description}</p> : null}
								<span class="service-cue">Read the case study
									<svg
										width="15"
										height="15"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<line x1="5" y1="12" x2="19" y2="12" />
										<polyline points="12 5 19 12 12 19" />
									</svg>
								</span>
							</div>
						</a>
					))}
				</div>
			</section>
		) : null
	}

	<StackGlobe client:load />

	<Combined />

	<ClientsWall />

	<section class="glass section" id="posts">
		<div class="section-head">
			<div>
				<h2>Latest posts</h2>
				<p>Notes on building, and on the nasheed work.</p>
			</div>
			<a class="view-all" href="/posts">View all posts →</a>
		</div>
		{posts.length === 0 ? (
			<p class="empty-state">No posts published yet.</p>
		) : (
			<div class="card-grid">
				{posts.slice(0, 3).map((post) => {
					const readingTime =
						post.data.readingTime ??
						readingTimeFromText(post.body) ??
						undefined;
					return (
						<a class="grid-card" href={`/posts/${post.data.slug}`}>
							{post.data.thumbnail ? (
								<div class="grid-thumb">
									<img
										src={post.data.thumbnail}
										alt={post.data.title}
										loading="lazy"
									/>
								</div>
							) : null}
							<div class="grid-body">
								{post.data.tags?.[0] ? (
									<div class="tag-row">
										<span class="tag">{post.data.tags[0]}</span>
									</div>
								) : null}
								<h3>{post.data.title}</h3>
								{post.data.excerpt ? <p>{post.data.excerpt}</p> : null}
								<p class="grid-meta">
									{formatDate(post.data.publishedAt)}
									{readingTime ? ` · ${readingTime} min read` : ""}
								</p>
							</div>
						</a>
					);
				})}
			</div>
		)}
	</section>

	<section class="glass section" id="contact">
		<div class="section-head">
			<h2>Have a project in mind?</h2>
		</div>
		<p class="muted" style="margin:0 0 8px;">
			Tell me what you are building — I reply personally, usually within a day.
		</p>
		<div class="contact-info">
			<div class="info-row">
				<span>✉️</span>
				<a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
			</div>
			<div class="info-row">
				<span>📍</span>
				<span>{PROFILE.location}</span>
			</div>
		</div>
		<ContactForm source="homepage-contact" client:load />
	</section>
</Layout>
