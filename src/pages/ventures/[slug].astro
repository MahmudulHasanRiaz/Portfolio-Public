---
import Layout from "../../layouts/Layout.astro";
import DetailCta from "../../components/DetailCta.astro";
import DetailMedia from "../../components/DetailMedia.astro";
import DetailVideoFacade from "../../components/DetailVideoFacade.astro";
import KeyStrip from "../../components/KeyStrip.astro";
import MarkdownBody from "../../components/MarkdownBody.astro";
import PrevNext from "../../components/PrevNext.astro";
import { getEntry, getLiveEntry } from "astro:content";
import { getVentures, formatDate } from "../../lib/content";
import {
	SITE_URL,
	absUrl,
	dedupeBlocks,
	isRealUrl,
	mergeDetail,
	parseBodyBlocks,
} from "../../lib/detail";
import { PROFILE } from "../../data/site";

// On-demand detail route — hybrid live-then-static.
// Live entry first (Public Content API), then the build-time collection
// entry. After the next scheduled rebuild the page becomes a static file.
export const prerender = false;

const { slug } = Astro.params;
if (!slug) Astro.response.status = 404;

const liveResult = slug
	? await getLiveEntry("liveVentures", slug).catch(() => undefined)
	: undefined;
const liveEntry = liveResult?.entry;
if (liveEntry) Astro.cache.set(liveEntry);
const buildEntry = slug ? await getEntry("ventures", slug) : undefined;
const entry = liveEntry ?? buildEntry;
if (!entry) Astro.response.status = 404;

interface Metric {
	value: string;
	label: string;
}

interface VentureData {
	title?: string;
	description?: string;
	content?: string;
	tags?: string[];
	publishedAt?: string;
	thumbnail?: string;
	thumbnailType?: "image" | "video";
	thumbnailVideoUrl?: string;
	website?: string | null;
	gallery?: string[];
	videos?: Array<{ url: string; title?: string }>;
	stage?: string;
	location?: string;
	teamSize?: string;
	foundedDate?: string;
	metrics?: Metric[];
}

const liveData = liveEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const buildData = buildEntry?.data as unknown as
	| Record<string, unknown>
	| undefined;
const data = mergeDetail(buildData, liveData) as unknown as
	| VentureData
	| undefined;

// The body is the long description — never the one-liner repeated: any
// paragraph that restates the description is dropped (the live
// duplication bug — the same line rendered as subtitle AND as body).
const rawBody = data?.content ?? buildEntry?.body ?? "";
const bodyBlocks = dedupeBlocks(parseBodyBlocks(rawBody), [
	data?.description,
]);

const ventures = await getVentures();
const idx = slug ? ventures.findIndex((v) => v.data.slug === slug) : -1;
const prev = idx > 0 ? ventures[idx - 1] : undefined;
const next =
	idx >= 0 && idx < ventures.length - 1 ? ventures[idx + 1] : undefined;
const thumbOf = (v: (typeof ventures)[number] | undefined) =>
	v?.data.thumbnailType !== "video" && v?.data.thumbnail
		? v.data.thumbnail
		: null;

const title = data?.title ?? "Venture not published yet";
const description = data?.description;
const tags = data?.tags ?? [];
const website = isRealUrl(data?.website) ? data.website : null;

const isVideoThumb = data?.thumbnailType === "video";
const videoSrc = isVideoThumb
	? (data?.thumbnailVideoUrl ?? data?.thumbnail)
	: undefined;
const videoPoster =
	isVideoThumb && data?.thumbnailVideoUrl ? (data?.thumbnail ?? null) : null;
const coverImage =
	!isVideoThumb && data?.thumbnail ? data.thumbnail : videoPoster;

const pageUrl = `${SITE_URL}/ventures/${slug}`;
const jsonLd = data
	? {
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "Organization",
					name: title,
					...(description ? { description } : {}),
					...(website ? { url: website } : {}),
					founder: { "@type": "Person", name: PROFILE.name },
				},
				{
					"@type": "BreadcrumbList",
					itemListElement: [
						{
							"@type": "ListItem",
							position: 1,
							name: "Home",
							item: SITE_URL,
						},
						{
							"@type": "ListItem",
							position: 2,
							name: "Ventures",
							item: `${SITE_URL}/ventures`,
						},
						{
							"@type": "ListItem",
							position: 3,
							name: title,
							item: pageUrl,
						},
					],
				},
			],
		}
	: null;
---

<Layout
	title={`${title} — Mahmudul Hasan Riaz`}
	description={description}
	ogType="website"
	ogImage={coverImage ? absUrl(coverImage) : null}
	canonical={pageUrl}
>
	{!entry || !data ? (
		<section class="glass">
			<a class="back-link" href="/ventures">
				← All ventures
			</a>
			<h1 class="detail-title">Venture not published yet</h1>
			<p class="empty-state">This venture is not published yet.</p>
		</section>
	) : (
		<section class="glass">
			{jsonLd ? (
				<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
			) : null}

			<a href="/ventures" class="back-link">
				← All ventures
			</a>

			{data.thumbnail &&
				(isVideoThumb && videoSrc ? (
					<div class="detail-hero">
						<DetailVideoFacade
							src={videoSrc}
							poster={videoPoster}
							title={title}
						/>
					</div>
				) : (
					<div class="detail-hero">
						<img src={data.thumbnail} alt={title} />
					</div>
				))}
			<h1 class="detail-title">{title}</h1>
			{tags.length ? (
				<div class="tag-row" style="margin-top:12px;">
					{tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			) : null}
			{description ? <p class="detail-lede">{description}</p> : null}

			<KeyStrip
				items={[
					{
						label: "Published",
						value: formatDate(data.publishedAt),
					},
					data.stage ? { label: "Stage", value: data.stage } : null,
					data.location
						? { label: "Location", value: data.location }
						: null,
					data.teamSize
						? { label: "Team size", value: data.teamSize }
						: null,
					data.foundedDate
						? {
								label: "Founded",
								value: formatDate(data.foundedDate),
							}
						: null,
					tags.length
						? { label: "Category", value: tags.join(", ") }
						: null,
					website
						? { label: "Website", value: "Visit website", href: website }
						: null,
				]}
			/>

			{data.metrics?.length ? (
				<div class="metrics-band" aria-label="Venture metrics">
					{data.metrics.map((metric) => (
						<div class="metric-card">
							<strong>{metric.value}</strong>
							<span>{metric.label}</span>
						</div>
					))}
				</div>
			) : null}

			{bodyBlocks.length > 0 ? (
				<section class="detail-section" aria-label={`About ${title}`}>
					<h2 class="detail-h2">About {title}</h2>
					<MarkdownBody blocks={bodyBlocks} />
				</section>
			) : null}

			<DetailMedia
				gallery={data.gallery ?? []}
				videos={data.videos ?? []}
				exclude={data.thumbnail}
				altBase={`${title} gallery image`}
			/>

			<DetailCta
				title={`Thinking of building something like ${title}?`}
				text="Tell me about your venture — I reply personally."
				buttonLabel="Discuss a similar venture"
				source="venture-detail"
			/>

			<PrevNext
				prev={
					prev
						? {
								href: `/ventures/${prev.data.slug}`,
								title: prev.data.title,
								thumb: thumbOf(prev),
							}
						: null
				}
				next={
					next
						? {
								href: `/ventures/${next.data.slug}`,
								title: next.data.title,
								thumb: thumbOf(next),
							}
						: null
				}
			/>
		</section>
	)}
</Layout>
