---
import Layout from "../../layouts/Layout.astro";
import DetailMedia from "../../components/DetailMedia.astro";
import { getEntry, getLiveEntry, render } from "astro:content";
import { getVentures, formatDate } from "../../lib/content";
import { PROFILE } from "../../data/site";

// On-demand detail route — hybrid live-then-static.
// Live entry first (Public Content API), then the build-time collection
// entry. After the next scheduled rebuild the page becomes a static file.
export const prerender = false;

const { slug } = Astro.params;
if (!slug) Astro.response.status = 404;

const liveResult = slug
	? await getLiveEntry("liveVentures", slug).catch(() => undefined)
	: undefined;
const liveEntry = liveResult?.entry;
if (liveEntry) Astro.cache.set(liveEntry);
const buildEntry =
	!liveEntry && slug
		? await getEntry("ventures", slug)
		: undefined;

const entry = liveEntry ?? buildEntry;
if (!entry) Astro.response.status = 404;

const data = entry?.data as
	| {
			title?: string;
			description?: string;
			content?: string;
			tags?: string[];
			publishedAt?: string;
			thumbnail?: string;
			thumbnailType?: "image" | "video";
			website?: string | null;
			gallery?: string[];
			videos?: Array<{ url: string; title?: string }>;
	  }
	| undefined;

// Build-time entries render markdown; live entries carry a content string.
const rendered = buildEntry ? await render(buildEntry) : undefined;
const Content = rendered?.Content;
const bodyText = data?.content;

const ventures = await getVentures();
const idx = slug ? ventures.findIndex((v) => v.data.slug === slug) : -1;
const prev = idx > 0 ? ventures[idx - 1] : undefined;
const next =
	idx >= 0 && idx < ventures.length - 1 ? ventures[idx + 1] : undefined;

const title = data?.title ?? "Venture not published yet";
const description =
	data?.description ?? "A venture by Mahmudul Hasan Riaz.";
const tags = data?.tags ?? [];
const gallery = data?.gallery ?? [];
const videos = data?.videos ?? [];
const website = data?.website ?? null;

const jsonLd = data
	? {
			"@context": "https://schema.org",
			"@type": "Organization",
			name: title,
			description,
			...(website ? { url: website } : {}),
			founder: { "@type": "Person", name: PROFILE.name },
		}
	: null;
const breadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Home", item: "https://riaz.com.bd/" },
		{ "@type": "ListItem", position: 2, name: "Ventures", item: "https://riaz.com.bd/ventures" },
		{ "@type": "ListItem", position: 3, name: title },
	],
};
---

<Layout title={`${title} — Mahmudul Hasan Riaz`} description={description}>
	{jsonLd ? (
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	) : null}
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

	<p>
		<a href="/ventures" class="back-link">← All ventures</a>
	</p>

	{!entry || !data ? (
		<section class="glass section">
			<p class="empty-state">This venture is not published yet.</p>
		</section>
	) : (
		<article>
			{data.thumbnailType === "video" && data.thumbnail ? (
				<div class="detail-hero">
					<video src={data.thumbnail} controls preload="metadata" />
				</div>
			) : data.thumbnail ? (
				<div class="detail-hero">
					<img src={data.thumbnail} alt={title} />
				</div>
			) : null}
			<h1 class="detail-title">{title}</h1>
			{description ? <p class="detail-meta">{description}</p> : null}

			<div class="key-strip">
				{data.publishedAt ? (
					<span>
						Published <b>{formatDate(data.publishedAt)}</b>
					</span>
				) : null}
				{tags.length ? <span>{tags.join(", ")}</span> : null}
				{website ? (
					<span>
						<a href={website} target="_blank" rel="noreferrer">
							Visit website →
						</a>
					</span>
				) : null}
			</div>

			<div class="detail-body">
				{Content ? (
					<Content />
				) : bodyText ? (
					bodyText.split(/\n\s*\n/).map((para) => <p>{para}</p>)
				) : description ? (
					<p>{description}</p>
				) : null}
			</div>

			{gallery.length > 0 || videos.length > 0 ? (
				<DetailMedia gallery={gallery} videos={videos} />
			) : null}

			<div class="detail-cta">
				<h3>Have a project in mind?</h3>
				<p>Tell me about it — I reply personally.</p>
				<button
					type="button"
					class="btn"
					data-open-contact
					data-contact-source="venture"
				>
					Contact me
				</button>
			</div>

			<nav class="prev-next" aria-label="Venture navigation">
				{prev ? (
					<a href={`/ventures/${prev.data.slug}`}>
						<span class="pn-label">← Previous</span>
						<span class="pn-title">{prev.data.title}</span>
					</a>
				) : (
					<span />
				)}
				{next ? (
					<a class="next" href={`/ventures/${next.data.slug}`}>
						<span class="pn-label">Next →</span>
						<span class="pn-title">{next.data.title}</span>
					</a>
				) : (
					<span />
				)}
			</nav>
		</article>
	)}
</Layout>

<script is:inline>
	// Open the shared contact form from this detail page's CTA.
	document.querySelectorAll("[data-open-contact]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const source = btn.getAttribute("data-contact-source") || undefined;
			const service = btn.getAttribute("data-contact-service") || undefined;
			window.dispatchEvent(
				new CustomEvent("open-contact", { detail: { service, source } }),
			);
		});
	});
</script>
