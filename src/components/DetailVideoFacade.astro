---
// Video thumbnail facade (preview's DemoVideoPlayer pattern): a poster
// image with a play control — the video itself loads only when the
// visitor taps play. The swap to a <video> element is wired by the
// shared public/js/detail.js (delegated, no inline script in <main>).
// When there is no poster image, an accent tile with a play button
// stands in — never a black void.
import { getDict, type Dict, type Lang } from "../lib/i18n";

interface Props {
	/** Video URL (thumbnailVideoUrl when present, else the thumbnail). */
	src: string;
	/** Poster image URL, when the thumbnail is an image. */
	poster?: string | null;
	title: string;
	lang?: Lang;
	dict?: Dict;
}

const { src, poster, title, lang = "en", dict } = Astro.props;
// Defense-in-depth: a poster must never be a video URL. If the poster
// is the video itself (or looks like a video file), treat it as absent
// so no broken <img> renders and no <video poster> is set.
const safePoster =
	poster && poster !== src && !/\.(mp4|webm|mov|m4v)([?#]|$)/i.test(poster)
		? poster
		: null;
const t = dict ?? getDict(lang);
const playLabel = lang === "bn" ? `${title} প্লে করুন` : `Play ${title}`;
---

<button
	type="button"
	class="video-facade"
	data-video-facade
	data-src={src}
	data-poster={safePoster ?? ""}
	aria-label={playLabel}
>
	{safePoster ? (
		<img src={safePoster} alt={title} loading="lazy" />
	) : (
		<span class="video-facade-tile" aria-hidden="true">
			<svg
				width="52"
				height="52"
				viewBox="0 0 24 24"
				fill="currentColor"
				aria-hidden="true"
			>
				<path d="M8 5.5v13l11-6.5z" />
			</svg>
		</span>
	)}
	<span class="play-btn" aria-hidden="true">
		<svg
			width="28"
			height="28"
			viewBox="0 0 24 24"
			fill="currentColor"
			aria-hidden="true"
		>
			<path d="M8 5.5v13l11-6.5z" />
		</svg>
	</span>
	<span class="play-label">{t.playVideo}</span>
</button>
