---
import BrandIcon from "./BrandIcon.astro";
import { PLATFORMS } from "../data/site";
import { getVentures } from "../lib/content";

const ventures = await getVentures();
const musicPlatforms = PLATFORMS.filter((p) => p.group === "music");
// Preview mini-row copy (authorized preview content): SHORT one-line
// descriptions that fit in full — the live API's long descriptions
// get cut off mid-sentence here. Long descriptions stay on the
// venture detail pages; only the mini-row uses the short one.
const VENTURE_SHORT: Record<string, string> = {
	hisabkit: "Accounting toolkit for small Bangladeshi businesses.",
	clouddesk: "Remote-work tools for distributed teams.",
	skillbridge: "Connecting skilled freelancers with local businesses.",
};
// Preview order: HisabKit, CloudDesk, SkillBridge (live API sorts
// newest-first, which renders them reversed).
const VENTURE_ORDER = ["hisabkit", "clouddesk", "skillbridge"];
const orderedVentures = [...ventures].sort((a, b) => {
	const ai = VENTURE_ORDER.indexOf(a.data.slug);
	const bi = VENTURE_ORDER.indexOf(b.data.slug);
	return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});
// Real venture thumbnails from the preview assets (local files, never
// a bare letter tile while a photo exists).
const VENTURE_FALLBACK_THUMB: Record<string, string> = {
	hisabkit: "/ventures/hisabkit.jpg",
	clouddesk: "/ventures/clouddesk.jpg",
	skillbridge: "/ventures/skillbridge.jpg",
};
// Short artist points, verbatim from the React preview.
const artistShortPoints = [
	"Nasheed, tilawat, podcast and lecture releases",
	"Hafiz — memorised the Qur'an; Islamic scholar",
	"10+ releases across YouTube and Spotify",
];
---

<section class="glass section" id="beyond">
	<div class="section-head">
		<h2>Beyond the code</h2>
	</div>
	<p class="muted" style="margin:0 0 16px;font-size:14px;">
		One person, two more callings — building companies, and recording
		nasheeds.
	</p>
	<div class="combined-grid">
		<div class="combined-half">
			<h3>
				<span class="half-icon" aria-hidden="true">
					<svg
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
						<path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
						<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
						<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
					</svg>
				</span>
				Entrepreneur &amp; Public Figure
			</h3>
			<p>
				Founder of three ventures — and alongside them, community
				and charitable initiatives in Dhaka, and talks on faith,
				work and technology.
			</p>
			{
				orderedVentures.length === 0 ? (
					<p class="muted" style="margin:0;font-size:14px;">
						Ventures will appear here when published.
					</p>
				) : (
					orderedVentures.map((venture) => (
						<a
							class="mini-row"
							href={`/ventures/${venture.data.slug}`}
						>
							<span class="mini-thumb">
								{venture.data.thumbnail ||
								VENTURE_FALLBACK_THUMB[venture.data.slug] ? (
									<img
										src={
											venture.data.thumbnail ??
											VENTURE_FALLBACK_THUMB[
												venture.data.slug
											]
										}
										alt=""
										loading="lazy"
									/>
								) : (
									<span
										style="display:flex;width:100%;height:100%;align-items:center;justify-content:center;font-size:20px;font-weight:800;color:var(--accent);background:var(--accent-wash);"
										aria-hidden="true"
									>
										{venture.data.title.charAt(0)}
									</span>
								)}
							</span>
							<span class="mini-text">
								<b>{venture.data.title}</b>
								{VENTURE_SHORT[venture.data.slug] ??
								venture.data.description ? (
									<span>
										{VENTURE_SHORT[venture.data.slug] ??
											venture.data.description}
									</span>
								) : null}
							</span>
							<span
								class="mini-arrow"
								style="margin-left:auto;flex:none;color:var(--accent-strong);font-weight:700;"
								aria-hidden="true"
							>
								→
							</span>
						</a>
					))
				)
			}
			<p style="margin:14px 0 0;text-align:right;">
				<a class="view-all" href="/ventures">
					View all ventures →
				</a>
			</p>
		</div>
		<div class="combined-half">
			<h3>
				<span class="half-icon" aria-hidden="true">
					<svg
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
						<path d="M19 10v2a7 7 0 0 1-14 0v-2" />
						<line x1="12" x2="12" y1="19" y2="22" />
					</svg>
				</span>
				Islamic Artist
			</h3>
			<ul class="artist-points">
				{artistShortPoints.map((point) => (
					<li>{point}</li>
				))}
			</ul>
			<div class="platform-chips">
				{musicPlatforms.map((platform) => (
					<a class="platform-chip" href={platform.url}>
						<BrandIcon
							icon={platform.icon}
							name={platform.name}
							size={16}
						/>
						{platform.name}
					</a>
				))}
			</div>
		</div>
	</div>
	<div class="combined-cta">
		<p>
			<strong>Want the whole picture?</strong>
			Every venture and every release, in full — on the Know Me page.
		</p>
		<a class="btn" href="/know-me">Know Me →</a>
	</div>
</section>
