---
import { CLIENTS } from "../data/site";
import { applySiteCopy, getDict, type Lang } from "../lib/i18n";
import { getSiteSettings } from "../lib/settings";

interface Props {
	lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = applySiteCopy(getDict(lang), lang, await getSiteSettings());
---

<section class="glass section" id="clients">
	<div class="section-head">
		<h2>{t.clientsTitle}</h2>
	</div>
	<div class="clients-grid">
		{CLIENTS.map((client) => (
			<div class="client-cell">
				<span class="client-wordmark">{client.name}</span>
			</div>
		))}
	</div>
</section>
