---
// Grid card for the projects archive — thumbnail, title, description, tags.
import { truncateShort } from "../lib/content";

interface Props {
	project: {
		slug: string;
		title: string;
		description: string;
		tags: string[];
		thumbnail?: string | null;
	};
}

const { project } = Astro.props;
---

<a class="grid-card" href={`/projects/${project.slug}`}>
	<div class="grid-thumb">
		{
			project.thumbnail ? (
				<img src={project.thumbnail} alt={project.title} loading="lazy" />
			) : (
				<span class="thumb-fallback" aria-hidden="true">
					{project.title.charAt(0)}
				</span>
			)
		}
	</div>
	<div class="grid-body">
		<h3>{project.title}</h3>
		<p>{truncateShort(project.description)}</p>
		{
			project.tags.length > 0 && (
				<div class="tag-row">
					{project.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			)
		}
	</div>
</a>
