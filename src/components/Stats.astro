---
import { STATS } from "../data/site";
import { applySiteCopy, getDict, type Lang } from "../lib/i18n";
import { getSiteSettings } from "../lib/settings";

interface Props {
	lang?: Lang;
}

const { lang = "en" } = Astro.props;
// Stat labels in the page language (values are the real proof
// figures — identical in both languages). EN labels always come from
// build-time (the API deliberately does not emit them); on /bn/ pages
// the admin's positional bn.statsLabels overlay wins per slot, with
// `null` meaning "no Bangla yet" → build-time Bangla label.
const settings = await getSiteSettings();
const t = applySiteCopy(getDict(lang), lang, settings);
const bnLabels = lang === "bn" ? (settings.bn?.statsLabels ?? []) : [];
const labels = [t.statYears, t.statProjects, t.statClients, t.statReleases].map(
	(label, i) => {
		const bnLabel = bnLabels[i];
		return typeof bnLabel === "string" && bnLabel ? bnLabel : label;
	},
);
---

<section class="glass section stats-glass" id="stats">
	<div class="proof-strip">
		{STATS.map((stat, i) => (
			<div class="proof-cell">
				<div class="proof-num">{stat.value}</div>
				<div class="proof-label">{labels[i] ?? stat.label}</div>
			</div>
		))}
	</div>
</section>
