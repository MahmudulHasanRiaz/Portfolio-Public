---
 // Site footer — flush to the bottom of the page (.site-footer has square
// bottom corners and no bottom margin; the Layout removes the page
// column's bottom padding). Only the 5 primary platforms here — every
// platform lives on /platforms instead. NO Spotify in the primaries.
// Identity line: SE footer keeps the 3 identities from the preview
// (Software Engineer · Entrepreneur · Islamic Artist); Know Me keeps
// all 5. Top row: identity left, social icons right on the SAME row.
// Bottom row: "Contact me →" text link left, "All platforms →" right.
import BrandIcon from "./BrandIcon.astro";
import { FOOTER_PRIMARIES, PROFILE } from "../data/site";

interface Props {
	profile?: "se" | "knowme";
}

const { profile = "se" } = Astro.props;

const sub =
	profile === "knowme"
		? "Software Engineer · Entrepreneur · Nasheed Artist · Hafiz-Alem · Public Figure — Dhaka, Bangladesh"
		: "Software Engineer · Entrepreneur · Islamic Artist — Dhaka, Bangladesh";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div
		style="display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;"
	>
		<div style="min-width:0;">
			<p class="footer-identity">{PROFILE.name}</p>
			<p class="footer-sub">{sub}</p>
		</div>
		<div class="footer-socials" style="margin-top:0;flex:none;">
			{
				FOOTER_PRIMARIES.map((platform) => (
					<a
						href={platform.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={platform.name}
					>
						<BrandIcon icon={platform.icon} name={platform.name} size={20} />
					</a>
				))
			}
		</div>
	</div>
	<div
		class="footer-links"
		style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;justify-content:space-between;"
	>
		<button type="button" class="footer-text-link" data-open-contact>
			Contact me →
		</button>
		<a href="/platforms">All platforms →</a>
	</div>
	<p class="footer-copyright">
		© {year} {PROFILE.name}. All rights reserved.
	</p>
</footer>

<script>
	// Footer "Contact me" opens the shared contact modal (see ContactModal).
	document
		.querySelector("[data-open-contact]")
		?.addEventListener("click", () => {
			window.dispatchEvent(
				new CustomEvent("open-contact", { detail: { source: "footer" } }),
			);
		});
</script>
