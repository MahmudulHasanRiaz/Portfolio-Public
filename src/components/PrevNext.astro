---
// Previous / next detail navigation. Renders only the sides that exist;
// an empty span holds the grid column so a lone "Next" still sits right.
// Stacked on mobile, two columns at sm+ (preview mold); the next card
// flips row-reverse and right-aligns. Titles wrap (min-w-0 + break
// words) instead of truncating at the card edge. An optional 80×56
// thumbnail renders beside the label, as in the preview.
import { getDict, type Dict, type Lang } from "../lib/i18n";
interface PrevNextItem {
	href: string;
	title: string;
	thumb?: string | null;
}

interface Props {
	prev?: PrevNextItem | null;
	next?: PrevNextItem | null;
	lang?: Lang;
	dict?: Dict;
}

const { prev = null, next = null, lang = "en", dict } = Astro.props;
const t = dict ?? getDict(lang);

// Unsplash thumbs ship at w=1200 in content/API rows but the prev/next
// thumb renders at 80×56 (2x retina ≈ 160px) — request w=320/q=75
// instead. Non-Unsplash URLs pass through.
const sizedThumb = (url: string | null | undefined, w = 320) =>
	url?.includes("images.unsplash.com")
		? url.replace(/w=\d+/, `w=${w}`).replace(/q=\d+/, "q=75")
		: url;
---

{
	(prev || next) && (
		<nav class="prev-next" aria-label={`${t.previous} / ${t.next}`}>
			{prev ? (
				<a href={prev.href}>
					{prev.thumb ? (
						<img
							class="pn-thumb"
							src={sizedThumb(prev.thumb)}
							alt=""
							width="80"
							height="56"
							loading="lazy"
							decoding="async"
						/>
					) : null}
					<span class="pn-body">
						<span class="pn-label">← {t.previous}</span>
						<span class="pn-title">{prev.title}</span>
					</span>
				</a>
			) : (
				<span />
			)}
			{next ? (
				<a class="next" href={next.href}>
					{next.thumb ? (
						<img
							class="pn-thumb"
							src={sizedThumb(next.thumb)}
							alt=""
							width="80"
							height="56"
							loading="lazy"
							decoding="async"
						/>
					) : null}
					<span class="pn-body">
						<span class="pn-label">{t.next} →</span>
						<span class="pn-title">{next.title}</span>
					</span>
				</a>
			) : (
				<span />
			)}
		</nav>
	)
}
