---
import { SERVICES } from "../data/site";
import BrandIcon from "./BrandIcon.astro";
import ServiceModal from "./ServiceModal";
import { getDict, type Lang } from "../lib/i18n";

interface Props {
	lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = getDict(lang);
---

<section class="glass section" id="services">
	<div class="section-head">
		<div>
			<h2>{t.servicesTitle}</h2>
			<p>{t.servicesSub}</p>
		</div>
	</div>
	<div class="services-grid">
		{SERVICES.map((service) => (
			<button
				type="button"
				class="service-card"
				style="text-align:left;"
				data-service-slug={service.slug}
				aria-haspopup="dialog"
				aria-label={`${t.learnMoreAbout} ${service.name}`}
			>
				<span class="service-icon">
					{service.icon ? (
						<BrandIcon icon={service.icon} name={service.name} size={26} />
					) : service.lucide === "Database" ? (
						<svg
							width="26"
							height="26"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<ellipse cx="12" cy="5" rx="9" ry="3" />
							<path d="M3 5v14a9 3 0 0 0 18 0V5" />
							<path d="M3 12a9 3 0 0 0 18 0" />
						</svg>
					) : service.lucide === "Code" ? (
						<svg
							width="26"
							height="26"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<polyline points="16 18 22 12 16 6" />
							<polyline points="8 6 2 12 8 18" />
						</svg>
					) : (
						<svg
							width="26"
							height="26"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
							<polyline points="16 7 22 7 22 13" />
						</svg>
					)}
				</span>
				<span style="min-width:0;flex:1;">
					<h3>{service.name}</h3>
				</span>
			</button>
		))}
	</div>
	{/* Service detail modal — the brief + CTA live here, not on the card. */}
	<ServiceModal lang={lang} dict={t} client:load />
</section>

<style>
	/* Cards show name + icon only: centre the name against the icon tile. */
	.service-card {
		align-items: center;
	}
</style>

<script>
	// Opens the service detail modal (ServiceModal island listens for
	// "open-service"). Guarded against double-binding: Services.astro is
	// rendered on both the home and Know Me pages, so an element already
	// bound by the other instance is skipped.
	document
		.querySelectorAll("[data-service-slug]:not([data-service-bound])")
		.forEach((el) => {
			el.setAttribute("data-service-bound", "");
			el.addEventListener("click", () => {
				const target = el as HTMLElement;
				window.dispatchEvent(
					new CustomEvent("open-service", {
						detail: { slug: target.dataset.serviceSlug },
					}),
				);
			});
		});
</script>
