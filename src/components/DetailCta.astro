---
// Centered CTA box at the bottom of a detail page. The button dispatches
// the "open-contact" event the ContactModal island listens for, carrying
// the optional service pre-selection and the source section. An optional
// link (e.g. case study → "View the project") renders beside the button.
interface Props {
	title: string;
	text: string;
	service?: string;
	source: string;
	buttonLabel?: string;
	linkHref?: string;
	linkLabel?: string;
}

const {
	title,
	text,
	service,
	source,
	buttonLabel = "Contact me",
	linkHref,
	linkLabel,
} = Astro.props;
---

<div class="detail-cta">
	<h3>{title}</h3>
	<p>{text}</p>
	<div class="cta-actions">
		<button
			type="button"
			class="btn"
			data-open-contact
			data-service={service}
			data-source={source}
		>
			{buttonLabel}
		</button>
		{linkHref && linkLabel && (
			<a class="btn btn-ghost" href={linkHref}>
				{linkLabel}
			</a>
		)}
	</div>
</div>

<script>
	// One delegated listener for every [data-open-contact] button on the
	// page — DetailCta instances share it instead of each binding its own.
	(function () {
		const flag = window as unknown as { __detailCtaWired?: boolean };
		if (flag.__detailCtaWired) return;
		flag.__detailCtaWired = true;
		document.addEventListener("click", function (event) {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const button = target.closest("[data-open-contact]");
			if (!button) return;
			const service = button.getAttribute("data-service") || undefined;
			const source = button.getAttribute("data-source") || undefined;
			window.dispatchEvent(
				new CustomEvent("open-contact", { detail: { service, source } }),
			);
		});
	})();
</script>
