---
import { Picture } from "astro:assets";
// Fallback portrait — imported from public/ DELIBERATELY (not a
// src/assets/ duplicate): the file stays the single source for the
// fallback, the post-detail author avatar and the og:image fallback
// (site.ts / Layout.astro), so no 147KB binary is committed twice.
import speakerFallback from "../../public/speaker.jpg";
import { PROFILE, STATS } from "../data/site";
import { getStats } from "../lib/content";
import { getSiteSettings, type SettingsBn } from "../lib/settings";
import { applySiteCopy, getDict, type Lang } from "../lib/i18n";
import { optimizedImageUrl, optimizedSrcset } from "../lib/images";
import HeroDesignation from "./HeroDesignation";

interface Props {
	profile: "se" | "knowme";
	lang?: Lang;
}

const { profile, lang = "en" } = Astro.props;
const isKnowMe = profile === "knowme";

// Hero portrait from the admin panel (Public Content API settings).
// Falls back to the build-time repo portrait when the API is unset or
// unreachable, so the build never breaks.
const settings = await getSiteSettings();
const t = applySiteCopy(getDict(lang), lang, settings);
// Floating stat chips — the NUMBERS are live, the suffix words stay in
// the dictionary (so Bangla keeps working). Chip 1 derives from the
// live stats (stats[1] = 80+ Projects): the stats section and the chip
// share one source of truth. Chip 2 has no structured live source —
// no ordersPerDay metric exists in any DB row or API response (the
// "2,000–5,000" range lives only in prose), so it reads
// settings.heroChips[1] (dashboard migration 0031 seed); the number
// below is only the build-time fallback for an unreachable API, the
// same role build-time STATS plays for the stats section.
const stats = await getStats();
const chipProjects = stats[1]?.value ?? STATS[1].value;
const chipOrders = settings.heroChips?.[1] ?? "2,000–5,000";
const photoUrl = settings.portraitUrl ?? PROFILE.photo;
// Admin Bangla hero copy (settings.bn) wins over the English settings
// copy on /bn/ pages; the English settings copy (admin-managed) wins
// over the dictionary; the dictionary is the last resort — never a
// blank headline.
const bnCopy: SettingsBn = lang === "bn" ? (settings.bn ?? {}) : {};
const str = (v: unknown) => (typeof v === "string" && v ? v : undefined);
const heroHeadline =
	str(bnCopy.heroHeadline) ??
	str(isKnowMe ? settings.knowMeHeadline : settings.heroHeadline) ??
	(isKnowMe ? t.knowMeHeadline : t.heroHeadline);
const heroDesc =
	str(bnCopy.heroDescription) ??
	str(isKnowMe ? settings.knowMeSub : settings.heroDescription) ??
	(isKnowMe ? t.knowMeSub : t.heroDescription);
const designations =
	lang === "bn" ? t.designationKnowMe : [...PROFILE.designations];
---

<section class="glass hero" id="top">
	<div class="hero-photo-wrap">
		<div class="hero-photo-frame">
			{/* Build-time fallback portrait: local asset, AVIF/WebP +
			    responsive widths (PageSpeed 2026-11-10: the 147KB
			    JPEG was the LCP element, 3.5s on mobile). `priority`
			    sets loading=eager + decoding=sync + fetchpriority
			    high; `sizes` is honest to the frame (22rem / 352px
			    mobile, 5fr column / ~412px desktop). The admin
			    portrait (live settings) is remote — it goes through
			    the /api/image route when it lives on
			    files.riaz.com.bd (AVIF/WebP, quality 75, widths
			    352/704/1068 clamped to the whitelist), so a new
			    admin portrait is optimized on first request with no
			    rebuild; any other remote URL renders unchanged.
			    Dev / on-demand renders only; the static build always
			    takes the Picture branch. */}
			{photoUrl === PROFILE.photo ? (
				<Picture
					src={speakerFallback}
					formats={["avif", "webp"]}
					widths={[352, 576, 704, 1068]}
					sizes="(max-width: 1023px) 352px, 412px"
					quality={75}
					priority
					// LCP render delay (PageSpeed 2026-11-10: the hero
					// loads in 210ms but paints 1,930ms later): `priority`
					// sets decoding="sync" by default, which forces the
					// AVIF decode onto the main thread and blocks the
					// paint on it. An explicit decoding="async" wins
					// over that default (Astro resolves with ??=), so
					// the image still loads eager + fetchpriority high
					// but decodes off the paint path. No visual change.
					decoding="async"
					alt={t.photoAlt}
					data-hero-photo
				/>
			) : (
				<img
					src={optimizedImageUrl(photoUrl, 704)}
					srcset={optimizedSrcset(photoUrl, [352, 704, 1068])}
					sizes="(max-width: 1023px) 352px, 412px"
					alt={t.photoAlt}
					width="640"
					height="800"
					loading="eager"
					decoding="async"
					fetchpriority="high"
					data-hero-photo
				/>
			)}
			<div class="hero-photo-gradient" aria-hidden="true" />
			<svg
				class="hero-runlight"
				viewBox="0 0 100 125"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				{/* Perimeter runlight (preview): faint continuous trace +
				    a short soft teal segment travelling around it. The
				    segment is soft (0.38 opacity, round caps, glow) —
				    never a hard thin line. */}
				<rect
					class="trace-base"
					x="0.5"
					y="0.5"
					width="99"
					height="124"
					vector-effect="non-scaling-stroke"
				/>
				<rect
					class="trace-glow"
					x="0.5"
					y="0.5"
					width="99"
					height="124"
					pathLength="400"
					vector-effect="non-scaling-stroke"
				/>
			</svg>
		</div>
		<div class="hero-badge-anchor">
			<HeroDesignation
				profile={profile}
				designations={designations}
				client:idle
			/>
		</div>
	</div>
	<div class="hero-copy">
		<h1 class="hero-name">{PROFILE.name}</h1>
		{
			isKnowMe ? (
				<>
					<p class="hero-headline">{heroHeadline}</p>
					<p class="hero-desc">{heroDesc}</p>
					<div class="hero-ctas">
						<a class="btn" href="#releases">
							{t.listenReleases}
						</a>
						<a class="btn btn-ghost" href="#follow-connect">
							{t.followConnect}
						</a>
					</div>
				</>
			) : (
				<>
					<p class="hero-headline">{heroHeadline}</p>
					<p class="hero-desc">{heroDesc}</p>
					<p class="hero-location">
						<svg
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
							<circle cx="12" cy="10" r="3" />
						</svg>
						{t.heroLocation}
					</p>
					<div class="hero-ctas">
						<a class="btn" href="#projects">
							{t.viewMyWork}
						</a>
						<button
							type="button"
							class="btn btn-ghost"
							data-contact-source="hero"
						>
							{t.contactMe}
						</button>
					</div>
				</>
			)
		}
	</div>
	{/* Floating stat chips — direct children of the hero CARD (not the
	    photo): top-right and bottom-right corners of the card, fully
	    visible, overlapping the card edge slightly like the preview. */}
	<div class="hero-photo-float" aria-hidden="true">
		<div class="hero-photo-float-card">
			<strong>{chipProjects}</strong>
			<span>{t.projectsShipped}</span>
		</div>
		<div class="hero-photo-float-card">
			<strong>{chipOrders}</strong>
			<span>{t.ordersDaily}</span>
		</div>
	</div>
</section>

<script is:inline>
	// Live portrait + favicon swap (hybrid live-then-static, live half):
	// after an admin portrait or favicon update, /api/settings returns
	// the new URL(s) and the hero photo / browser-tab icon swap without
	// waiting for a rebuild. DEFERRED until after window load —
	// PageSpeed 2026-11-10: the /api/settings fetch (2.4s) was the
	// longest critical-path item and the src swap re-painted the LCP
	// element at ~3.5s. The fallback photo IS the same speaker photo,
	// so swapping after load is visually identical and LCP stays on
	// the fast build-time image. Fails silently — no console errors,
	// no visual change — when the fetch fails or a URL already matches
	// the rendered one.
	(function () {
		// Same rule as src/lib/images.ts, inlined for this script:
		// a files.riaz.com.bd portrait goes through /api/image
		// (widths clamped to the route whitelist); anything else
		// renders unchanged.
		function optimizedPortrait(url) {
			if (
				typeof url === "string" &&
				url.indexOf("https://files.riaz.com.bd/") === 0
			) {
				return (
					"/api/image?u=" +
					encodeURIComponent(url) +
					"&w=720"
				);
			}
			return url;
		}
		function optimizedSrcset(url) {
			if (
				typeof url === "string" &&
				url.indexOf("https://files.riaz.com.bd/") === 0
			) {
				return [360, 720, 1024]
					.map(function (w) {
						return (
							"/api/image?u=" +
							encodeURIComponent(url) +
							"&w=" +
							w +
							" " +
							w +
							"w"
						);
					})
					.join(", ");
			}
			return null;
		}
		function swap() {
			try {
				fetch("/api/settings", { signal: AbortSignal.timeout(8000) })
					.then(function (res) {
						return res.ok ? res.json() : null;
					})
					.then(function (data) {
						if (!data) return;
						if (
							typeof data.portraitUrl === "string" &&
							data.portraitUrl
						) {
							var img = document.querySelector("img[data-hero-photo]");
							var nextSrc = optimizedPortrait(data.portraitUrl);
							if (
								img &&
								img.getAttribute("src") !== nextSrc
							) {
								// The hero renders as a <picture>
								// (AVIF/WebP sources); a bare img.src
								// change is ignored while a <source>
								// matches, so drop the sources first.
								var pic = img.closest("picture");
								if (pic) {
									pic
										.querySelectorAll("source")
										.forEach(function (s) {
											s.remove();
										});
								}
								// The <Picture> branch also leaves a
								// stale img srcset (local variants) —
								// with a srcset present the browser
								// ignores img.src, so drop it too and
								// set the optimized srcset instead.
								img.removeAttribute("srcset");
								img.removeAttribute("sizes");
								var nextSrcset = optimizedSrcset(
									data.portraitUrl,
								);
								if (nextSrcset) {
									img.setAttribute("srcset", nextSrcset);
									img.setAttribute(
										"sizes",
										"(max-width: 1023px) 352px, 412px",
									);
								}
								img.setAttribute("src", nextSrc);
							}
						}
						if (
							typeof data.faviconUrl === "string" &&
							data.faviconUrl
						) {
							var link = document.querySelector('link[rel="icon"]');
							if (
								link &&
								link.getAttribute("href") !== data.faviconUrl
							) {
								link.setAttribute("href", data.faviconUrl);
							}
						}
					})
					.catch(function () {});
			} catch {
				/* fetch unavailable — rendered photo / favicon stay */
			}
		}
		if (document.readyState === "complete") swap();
		else window.addEventListener("load", swap);
	})();
</script>

<script>
	// Opens the contact modal (ContactModal island listens for "open-contact").
	// Guarded against double-binding: Services.astro runs the same script,
	// so an element already bound by the other instance is skipped.
	document
		.querySelectorAll("[data-contact-source]:not([data-contact-bound])")
		.forEach((el) => {
			el.setAttribute("data-contact-bound", "");
			el.addEventListener("click", () => {
				const target = el as HTMLElement;
				const detail: { service?: string; source?: string } = {};
				if (target.dataset.service) detail.service = target.dataset.service;
				if (target.dataset.contactSource)
					detail.source = target.dataset.contactSource;
				window.dispatchEvent(new CustomEvent("open-contact", { detail }));
			});
		});
</script>
