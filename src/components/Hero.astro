---
import { PROFILE } from "../data/site";
import HeroDesignation from "./HeroDesignation";

interface Props {
	profile: "se" | "knowme";
}

const { profile } = Astro.props;
const isKnowMe = profile === "knowme";
---

<section class="glass hero" id="top">
	<div class="hero-photo-wrap">
		<div class="hero-photo-frame">
			<img
				src={PROFILE.photo}
				alt={PROFILE.photoAlt}
				width="640"
				height="800"
				fetchpriority="high"
			/>
			<div class="hero-photo-gradient" aria-hidden="true" />
			<svg
				class="hero-runlight"
				viewBox="0 0 100 125"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<rect
					class="trace-base"
					x="0.5"
					y="0.5"
					width="99"
					height="124"
					vector-effect="non-scaling-stroke"
				/>
				<rect
					class="trace-glow"
					x="0.5"
					y="0.5"
					width="99"
					height="124"
					pathLength="400"
					stroke-dasharray="56 344"
					vector-effect="non-scaling-stroke"
				/>
			</svg>
		</div>
		<div class="hero-badge-anchor">
			<HeroDesignation profile={profile} client:load />
		</div>
		<div class="hero-photo-float" aria-hidden="true">
			<div class="hero-photo-float-card">
				<strong>80+</strong>
				<span>Projects shipped</span>
			</div>
			<div class="hero-photo-float-card">
				<strong>2,000–5,000</strong>
				<span>Orders handled daily</span>
			</div>
		</div>
	</div>
	<div>
		<h1 class="hero-name">{PROFILE.name}</h1>
		{
			isKnowMe ? (
				<>
					<p class="hero-headline">{PROFILE.knowMeHeadline}</p>
					<p class="hero-desc">{PROFILE.knowMeSub}</p>
					<div class="hero-ctas">
						<a class="btn" href="#releases">
							Listen to the releases
						</a>
						<a class="btn btn-ghost" href="#follow-connect">
							Follow &amp; connect
						</a>
					</div>
				</>
			) : (
				<>
					<p class="hero-headline">{PROFILE.heroHeadline}</p>
					<p class="hero-desc">{PROFILE.heroDescription}</p>
					<p class="hero-location">
						<svg
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
							<circle cx="12" cy="10" r="3" />
						</svg>
						{PROFILE.location}
					</p>
					<div class="hero-ctas">
						<a class="btn" href="#projects">
							View my work
						</a>
						<button
							type="button"
							class="btn btn-ghost"
							data-contact-source="hero"
						>
							Contact me
						</button>
					</div>
				</>
			)
		}
	</div>
</section>

<script>
	// Opens the contact modal (ContactModal island listens for "open-contact").
	// Guarded against double-binding: Services.astro runs the same script,
	// so an element already bound by the other instance is skipped.
	document
		.querySelectorAll("[data-contact-source]:not([data-contact-bound])")
		.forEach((el) => {
			el.setAttribute("data-contact-bound", "");
			el.addEventListener("click", () => {
				const target = el as HTMLElement;
				const detail: { service?: string; source?: string } = {};
				if (target.dataset.service) detail.service = target.dataset.service;
				if (target.dataset.contactSource)
					detail.source = target.dataset.contactSource;
				window.dispatchEvent(new CustomEvent("open-contact", { detail }));
			});
		});
</script>
