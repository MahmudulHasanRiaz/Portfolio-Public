{
	"$schema": "node_modules/wrangler/config-schema.json",
	"assets": { "directory": "./dist" },
	"compatibility_date": "2026-11-08",
	"compatibility_flags": ["nodejs_compat"],
	"name": "portfolio-public",
	"observability": { "enabled": true },
	// Runtime env for the live loader (src/loaders/public-content.ts).
	// Mirrors the Worker Variable set in the Cloudflare dashboard so Git
	// deploys and dashboard settings stay in sync. This is a public URL,
	// not a secret.
	"vars": { "PUBLIC_CONTENT_API_URL": "https://admin.riaz.com.bd" }
}
